---
import Layout from '../layouts/Layout.astro';
import guestsData from '../data/guests.json';
import fomoStats from '../data/fomo.json';

const baseUrl = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";

const { summary, confirmed, maybe_form, maybe_verbal } = guestsData;
const seatsLeft = fomoStats.total_seats - summary.confirmed_heads;
const bedsLeft = fomoStats.total_accomodation - fomoStats.need_accomodation;
const confirmedPct = Math.min(100, Math.round((summary.confirmed_heads / fomoStats.total_seats) * 100));
const maybePct = Math.min(100 - confirmedPct, Math.round((summary.total_maybe_heads / fomoStats.total_seats) * 100));

interface NormalizedGuest {
  id: string;
  name: string;
  nickname: string;
  status: 'confirmed' | 'maybe' | 'verbal';
  source: string;
  party_size: number;
  plus_ones: number;
  is_family: boolean;
  plus_label_it: string;
  plus_label_en: string;
  partner_friend: string;
  city: string;
  region: string;
  group: string;
  music_note: string;
  hashtags: string[];
}

function stripEmoji(s: string): string {
  return (s || '').replace(/[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}]/gu, '').replace(/\s+/g, ' ').trim();
}

function extractHashtags(g: any, status: 'confirmed' | 'maybe' | 'verbal'): string[] {
  const tags = new Set<string>();
  const grp = stripEmoji(g.group || '').toLowerCase();
  const city = stripEmoji(g.city || g.region || '').toLowerCase();
  const reg = stripEmoji(g.region || '').toLowerCase();

  if (grp.includes('goliardia') || grp.includes('amici cretini')) tags.add('goliardia');
  if (grp.includes('karaoke')) tags.add('karaoke');
  if (grp.includes('elvetica')) tags.add('elvetica');
  if (grp.includes('sabauda')) tags.add('sabauda');
  if (grp.includes('riviera')) tags.add('riviera');
  if (grp.includes('palladiana')) tags.add('festeggiato');

  if (city.includes('zurigo') || city.includes('oberbuchsiten') || reg.includes('svizzera')) tags.add('svizzera');
  else if (city.includes('bologna') || city.includes('castel guelfo') || reg.includes('bologna')) tags.add('bologna');
  else if (city.includes('milano') || reg.includes('milano')) tags.add('milano');
  else if (city.includes('torino') || reg.includes('torino')) tags.add('torino');
  else if (city.includes('roma') || reg.includes('roma')) tags.add('roma');
  else if (city.includes('argenta') || reg.includes('ferrara')) tags.add('ferrara');
  else if (city.includes('rimini') || city.includes('san marino') || reg.includes('rimini')) tags.add('rimini');
  else if (city.includes('vienna') || city.includes('parigi')) tags.add('estero');
  else if (city) tags.add(city.split(/[\s(/,]+/)[0]);

  if (g.is_family) tags.add('famiglia');
  else if (g.plus_ones > 0) tags.add('piu-uno');
  if (g.nickname) tags.add('nickname');
  if (g.music_note) tags.add('dj');
  if (status === 'verbal') tags.add('senza-form');

  return Array.from(tags);
}

const allGuests: NormalizedGuest[] = [
  ...confirmed.map((g: any) => ({
    id: g.id,
    name: g.name || '',
    nickname: g.nickname || '',
    status: 'confirmed' as const,
    source: 'Form RSVP',
    party_size: g.party_size || 1,
    plus_ones: g.plus_ones || 0,
    is_family: Boolean(g.is_family),
    plus_label_it: g.plus_label_it || '',
    plus_label_en: g.plus_label_en || '',
    partner_friend: g.partner_friend || '',
    city: stripEmoji(g.city || ''),
    region: stripEmoji(g.region || ''),
    group: stripEmoji(g.group || ''),
    music_note: stripEmoji(g.music_note || ''),
    hashtags: extractHashtags(g, 'confirmed'),
  })),
  ...maybe_form.map((g: any) => ({
    id: g.id,
    name: g.name || '',
    nickname: g.nickname || '',
    status: 'maybe' as const,
    source: 'Form RSVP',
    party_size: g.party_size || 1,
    plus_ones: g.plus_ones || 0,
    is_family: Boolean(g.is_family),
    plus_label_it: g.plus_label_it || '',
    plus_label_en: g.plus_label_en || '',
    partner_friend: g.partner_friend || '',
    city: stripEmoji(g.city || ''),
    region: stripEmoji(g.region || ''),
    group: stripEmoji(g.group || ''),
    music_note: stripEmoji(g.music_note || ''),
    hashtags: extractHashtags(g, 'maybe'),
  })),
  ...maybe_verbal.map((g: any) => ({
    id: g.id,
    name: g.name || '',
    nickname: g.nickname || '',
    status: 'verbal' as const,
    source: stripEmoji(g.source || 'WhatsApp'),
    party_size: g.party_size || 1,
    plus_ones: 0,
    is_family: false,
    plus_label_it: '',
    plus_label_en: '',
    partner_friend: '',
    city: stripEmoji(g.city || ''),
    region: stripEmoji(g.region || ''),
    group: stripEmoji(g.group || ''),
    music_note: '',
    hashtags: extractHashtags(g, 'verbal'),
  })),
];

// Top hashtags sorted by frequency
const tagCounts = new Map<string, number>();
for (const g of allGuests) {
  for (const t of g.hashtags) {
    tagCounts.set(t, (tagCounts.get(t) || 0) + 1);
  }
}
const topHashtags = Array.from(tagCounts.entries())
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 12);
---

<Layout title="Invitati | Il 50° Compleanno Palladiano" currentPage="invitati">
  <main class="container synoptic-page">
    <!-- COMPACT SYNOPTIC HEADER & FOMO BAR -->
    <section class="synoptic-top">
      <div class="synoptic-title-row">
        <div>
          <h1>
            <span lang-it>Invitati</span>
            <span lang-en>Guest List</span>
          </h1>
          <p class="synoptic-sub">
            <span lang-it>29 Dicembre 2026 • Privacy-first (<code>Nome C.</code> + soprannomi + <code>+1</code>)</span>
            <span lang-en>December 29, 2026 • Privacy-first (<code>First L.</code> + nicknames + <code>+1</code>)</span>
          </p>
        </div>

        <div class="kpi-strip tabular">
          <div class="kpi-chip kpi-ok">
            <span class="kpi-val">{summary.confirmed_heads}</span>
            <span class="kpi-lbl" lang-it>Confermati</span>
            <span class="kpi-lbl" lang-en>Confirmed</span>
          </div>
          <div class="kpi-chip kpi-warn">
            <span class="kpi-val">{summary.total_maybe_heads}</span>
            <span class="kpi-lbl" lang-it>In Forse</span>
            <span class="kpi-lbl" lang-en>Maybe</span>
          </div>
          <div class="kpi-chip">
            <span class="kpi-val">{seatsLeft}</span>
            <span class="kpi-lbl" lang-it>Posti Liberi</span>
            <span class="kpi-lbl" lang-en>Seats Left</span>
          </div>
          <div class="kpi-chip">
            <span class="kpi-val">{bedsLeft}</span>
            <span class="kpi-lbl" lang-it>Letti Liberi</span>
            <span class="kpi-lbl" lang-en>Beds Left</span>
          </div>
        </div>
      </div>

      <div class="fomo-track" role="progressbar" aria-valuenow={summary.confirmed_heads} aria-valuemin={0} aria-valuemax={fomoStats.total_seats}>
        <div class="fomo-fill-ok" style={`width: ${confirmedPct}%`} title={`${summary.confirmed_heads} Confermati`}></div>
        <div class="fomo-fill-maybe" style={`width: ${maybePct}%`} title={`${summary.total_maybe_heads} In Forse`}></div>
      </div>
    </section>

    <!-- FILTER TOOLBAR: SEGMENTED STATUS + BOOLEAN SWITCHES + LIVE SEARCH -->
    <section class="toolbar">
      <div class="toolbar-row">
        <div class="segmented-control" role="radiogroup" aria-label="Stato partecipazione">
          <button type="button" class="seg-btn active" data-status="all" aria-pressed="true">
            <span lang-it>Tutti ({allGuests.length})</span>
            <span lang-en>All ({allGuests.length})</span>
          </button>
          <button type="button" class="seg-btn" data-status="confirmed" aria-pressed="false">
            <span lang-it>Confermati ({summary.confirmed_heads})</span>
            <span lang-en>Confirmed ({summary.confirmed_heads})</span>
          </button>
          <button type="button" class="seg-btn" data-status="maybe" aria-pressed="false">
            <span lang-it>In Forse ({summary.maybe_form_cards})</span>
            <span lang-en>Maybe ({summary.maybe_form_cards})</span>
          </button>
          <button type="button" class="seg-btn" data-status="verbal" aria-pressed="false">
            <span lang-it>Solo Chat ({summary.maybe_verbal_cards})</span>
            <span lang-en>Chat Only ({summary.maybe_verbal_cards})</span>
          </button>
        </div>

        <span class="toolbar-divider" aria-hidden="true"></span>

        <div class="bool-toggles">
          <button type="button" class="toggle-chip" id="togglePlus" role="switch" aria-checked="false">
            <span class="toggle-box" aria-hidden="true"></span>
            <span lang-it>+1 / Famiglia</span>
            <span lang-en>+1 / Family</span>
          </button>
          <button type="button" class="toggle-chip" id="toggleNick" role="switch" aria-checked="false">
            <span class="toggle-box" aria-hidden="true"></span>
            <span lang-it>Solo Nickname</span>
            <span lang-en>Nicknames Only</span>
          </button>
        </div>

        <div class="search-wrap">
          <svg class="search-svg" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" />
          </svg>
          <input
            type="search"
            id="guestSearchInput"
            class="search-input"
            placeholder="Cerca (/): Giua', Bologna..."
            aria-label="Cerca invitato"
          />
        </div>
      </div>

      <!-- CLICKABLE HASHTAGS BAR -->
      <div class="hashtag-bar" id="hashtagBar" aria-label="Filtra per hashtag">
        {topHashtags.map(([tag, count]) => (
          <button type="button" class="htag-pill" data-tag={tag}>
            <span>#{tag}</span>
            <span class="htag-count tabular">{count}</span>
          </button>
        ))}
        <button type="button" class="htag-clear" id="clearFiltersBtn" style="display: none;">
          <span lang-it>Reset filtri</span>
          <span lang-en>Reset filters</span>
        </button>
      </div>
    </section>

    <!-- L1 SYNOPTIC TABLE -->
    <section class="table-section">
      <div class="table-heading-row">
        <h2>
          <span lang-it>Sinottica</span>
          <span lang-en>Synoptic</span>
        </h2>
        <span class="visible-counter tabular" id="visibleCounter">{allGuests.length} / {allGuests.length}</span>
      </div>

      <div class="table-scroll">
        <table class="synoptic-table" id="guestsTable">
          <thead>
            <tr>
              <th class="col-status" title="Stato"></th>
              <th class="col-name">
                <span lang-it>Ospite</span>
                <span lang-en>Guest</span>
              </th>
              <th class="col-party">
                <span lang-it>Quota</span>
                <span lang-en>Party</span>
              </th>
              <th class="col-city">
                <span lang-it>Città</span>
                <span lang-en>City</span>
              </th>
              <th class="col-tags">Hashtag</th>
              <th class="col-source">
                <span lang-it>Stato / Fonte</span>
                <span lang-en>Status / Source</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {allGuests.map((g, idx) => {
              const rowTooltip = [
                g.group ? `Gruppo: ${g.group}` : '',
                g.partner_friend ? g.partner_friend : '',
                g.music_note ? `Musica: ${g.music_note}` : '',
                `Fonte: ${g.source}`,
              ].filter(Boolean).join(' · ');

              return (
                <tr
                  class={`guest-row row-${g.status}`}
                  data-idx={idx}
                  data-status={g.status}
                  data-has-plus={(g.plus_ones > 0 || g.is_family || Boolean(g.partner_friend)) ? 'true' : 'false'}
                  data-has-nick={g.nickname ? 'true' : 'false'}
                  data-tags={g.hashtags.join(',')}
                  data-search={`${g.name} ${g.nickname} ${g.city} ${g.region} ${g.group} ${g.partner_friend} ${g.hashtags.map(t => '#' + t).join(' ')}`.toLowerCase()}
                  title={rowTooltip}
                >
                  <!-- 1. MONOCHROME STATUS SVG -->
                  <td class="col-status">
                    {g.status === 'confirmed' && (
                      <span class="st-icon st-ok" title="Confermato">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                      </span>
                    )}
                    {g.status === 'maybe' && (
                      <span class="st-icon st-maybe" title="In Forse (Form)">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                        </svg>
                      </span>
                    )}
                    {g.status === 'verbal' && (
                      <span class="st-icon st-verbal" title="Solo Chat / Manca Form">
                        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                        </svg>
                      </span>
                    )}
                  </td>

                  <!-- 2. IDENTITY (NICKNAME + NOME C.) -->
                  <td class="col-name">
                    <div class="name-cell">
                      {g.nickname ? (
                        <>
                          <span class="nick-label">«{g.nickname}»</span>
                          {g.name && <span class="real-label">{g.name}</span>}
                        </>
                      ) : (
                        <span class="primary-label">{g.name}</span>
                      )}
                      {g.partner_friend && (
                        <span class="partner-inline">{g.partner_friend}</span>
                      )}
                    </div>
                  </td>

                  <!-- 3. PARTY / +1 MICRO-BADGE -->
                  <td class="col-party tabular">
                    {g.plus_ones > 0 ? (
                      <span class={`num-chip ${g.is_family ? 'num-chip--fam' : 'num-chip--plus'}`}>
                        +{g.plus_ones}
                      </span>
                    ) : g.plus_label_it ? (
                      <span class="num-chip num-chip--warn">+1?</span>
                    ) : (
                      <span class="num-muted">1</span>
                    )}
                  </td>

                  <!-- 4. CITY -->
                  <td class="col-city">
                    {g.city ? (
                      <span class="city-text">{g.city}</span>
                    ) : (
                      <span class="city-empty">—</span>
                    )}
                  </td>

                  <!-- 5. CLICKABLE HASHTAGS -->
                  <td class="col-tags">
                    <div class="row-tags">
                      {g.hashtags.slice(0, 3).map((tag) => (
                        <button type="button" class="row-htag" data-tag={tag}>#{tag}</button>
                      ))}
                    </div>
                  </td>

                  <!-- 6. SOURCE / ACTION -->
                  <td class="col-source">
                    {g.status === 'verbal' ? (
                      <a href={publicFormUrl} target="_blank" rel="noopener noreferrer" class="verbal-nudge" onclick="event.stopPropagation()">
                        <span lang-it>{g.source} · Manca Form</span>
                        <span lang-en>{g.source} · No Form</span>
                      </a>
                    ) : g.status === 'maybe' ? (
                      <span class="src-maybe">
                        <span lang-it>In forse</span>
                        <span lang-en>Maybe</span>
                      </span>
                    ) : (
                      <span class="src-ok">Form</span>
                    )}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      <div id="emptyState" class="empty-state" style="display: none;">
        <span lang-it>Nessun invitato corrisponde ai filtri attivi.</span>
        <span lang-en>No guests match the active filters.</span>
      </div>

      <p class="table-footnote">
        <em>
          <span lang-it>Clicca un #hashtag per filtrare, o clicca una riga per dettagli su musica, carovana e RSVP. Cognomi abbreviati per privacy.</span>
          <span lang-en>Click any #hashtag to filter, or click a row for music, convoy, and RSVP details. Last names abbreviated for privacy.</span>
        </em>
      </p>
    </section>

    <!-- COMPACT BOTTOM CTA -->
    <section class="bottom-strip">
      <span lang-it>Non vedi il tuo nome o vuoi aggiungere un soprannome goliardico?</span>
      <span lang-en>Missing your name or want to add a goliardic nickname?</span>
      <div class="bottom-actions">
        <a href={publicFormUrl} target="_blank" rel="noopener noreferrer" class="btn-mini btn-mini-gold">
          <span lang-it>Compila RSVP</span>
          <span lang-en>Fill RSVP</span>
        </a>
        <a href={`${baseUrl}/map`} class="btn-mini">
          <span lang-it>Mappa Auto</span>
          <span lang-en>Cars Map</span>
        </a>
      </div>
    </section>
  </main>

  <!-- L3 DEEP-DIVE DETAIL MODAL -->
  <dialog id="guestDetailDialog" class="detail-dialog">
    <div class="dialog-card">
      <div class="dialog-head">
        <div>
          <span id="dlgBadge" class="dlg-status-pill"></span>
          <h3 id="dlgTitle" class="dlg-title"></h3>
          <p id="dlgSubtitle" class="dlg-sub"></p>
        </div>
        <button type="button" id="dlgClose" class="dlg-close" aria-label="Chiudi">&times;</button>
      </div>
      <div class="dialog-body" id="dlgBody"></div>
      <div class="dialog-foot" id="dlgFoot"></div>
    </div>
  </dialog>

  <script is:inline define:vars={{ allGuests, publicFormUrl }}>
    (function() {
      const STORAGE_KEY = 'palladius_invitati_state_v1';
      const DEFAULTS = { status: 'all', tag: '', plus: '0', nick: '0', q: '' };

      function readState() {
        let saved = {};
        try { saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}'); } catch {}
        const params = Object.fromEntries(new URLSearchParams(window.location.search));
        return { ...DEFAULTS, ...saved, ...params };
      }

      function writeState(patch) {
        const next = { ...readState(), ...patch };
        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(next)); } catch {}
        const url = new URL(window.location.href);
        for (const [k, v] of Object.entries(next)) {
          if (!v || v === DEFAULTS[k]) url.searchParams.delete(k);
          else url.searchParams.set(k, String(v));
        }
        window.history.replaceState(next, '', url);
        return next;
      }

      const segBtns = document.querySelectorAll('.seg-btn');
      const togglePlus = document.getElementById('togglePlus');
      const toggleNick = document.getElementById('toggleNick');
      const searchInput = document.getElementById('guestSearchInput');
      const htagPills = document.querySelectorAll('.htag-pill');
      const clearBtn = document.getElementById('clearFiltersBtn');
      const rows = document.querySelectorAll('.guest-row');
      const counterEl = document.getElementById('visibleCounter');
      const emptyEl = document.getElementById('emptyState');

      const dialog = document.getElementById('guestDetailDialog');
      const dlgClose = document.getElementById('dlgClose');
      const dlgBadge = document.getElementById('dlgBadge');
      const dlgTitle = document.getElementById('dlgTitle');
      const dlgSubtitle = document.getElementById('dlgSubtitle');
      const dlgBody = document.getElementById('dlgBody');
      const dlgFoot = document.getElementById('dlgFoot');

      function applyUI() {
        const st = readState();
        const isPlus = st.plus === '1';
        const isNick = st.nick === '1';
        const q = (st.q || '').trim().toLowerCase();

        segBtns.forEach(btn => {
          const active = btn.getAttribute('data-status') === st.status;
          btn.classList.toggle('active', active);
          btn.setAttribute('aria-pressed', String(active));
        });

        if (togglePlus) {
          togglePlus.classList.toggle('active', isPlus);
          togglePlus.setAttribute('aria-checked', String(isPlus));
        }
        if (toggleNick) {
          toggleNick.classList.toggle('active', isNick);
          toggleNick.setAttribute('aria-checked', String(isNick));
        }
        if (searchInput && searchInput.value !== st.q) {
          searchInput.value = st.q || '';
        }

        document.querySelectorAll('.htag-pill, .row-htag').forEach(el => {
          el.classList.toggle('active', el.getAttribute('data-tag') === st.tag);
        });

        const hasActiveFilter = st.status !== 'all' || Boolean(st.tag) || isPlus || isNick || Boolean(q);
        if (clearBtn) clearBtn.style.display = hasActiveFilter ? '' : 'none';

        let visible = 0;
        rows.forEach(row => {
          const rStatus = row.getAttribute('data-status');
          const rPlus = row.getAttribute('data-has-plus') === 'true';
          const rNick = row.getAttribute('data-has-nick') === 'true';
          const rTags = (row.getAttribute('data-tags') || '').split(',').filter(Boolean);
          const rSearch = row.getAttribute('data-search') || '';

          let ok = true;
          if (st.status !== 'all' && rStatus !== st.status) ok = false;
          if (ok && isPlus && !rPlus) ok = false;
          if (ok && isNick && !rNick) ok = false;
          if (ok && st.tag && !rTags.includes(st.tag)) ok = false;
          if (ok && q && !rSearch.includes(q)) ok = false;

          row.style.display = ok ? '' : 'none';
          if (ok) visible++;
        });

        if (counterEl) counterEl.textContent = `${visible} / ${rows.length}`;
        if (emptyEl) emptyEl.style.display = visible === 0 ? 'block' : 'none';
      }

      segBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          writeState({ status: btn.getAttribute('data-status') || 'all' });
          applyUI();
        });
      });

      if (togglePlus) {
        togglePlus.addEventListener('click', () => {
          const cur = readState().plus === '1';
          writeState({ plus: cur ? '0' : '1' });
          applyUI();
        });
      }

      if (toggleNick) {
        toggleNick.addEventListener('click', () => {
          const cur = readState().nick === '1';
          writeState({ nick: cur ? '0' : '1' });
          applyUI();
        });
      }

      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          writeState({ q: e.target.value || '' });
          applyUI();
        });
      }

      function toggleTag(tag) {
        const cur = readState().tag;
        writeState({ tag: cur === tag ? '' : tag });
        applyUI();
      }

      htagPills.forEach(btn => {
        btn.addEventListener('click', () => toggleTag(btn.getAttribute('data-tag') || ''));
      });

      document.querySelectorAll('.row-htag').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleTag(btn.getAttribute('data-tag') || '');
        });
      });

      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          writeState({ ...DEFAULTS });
          applyUI();
        });
      }

      // Keyboard shortcut `/` focuses search
      document.addEventListener('keydown', (e) => {
        if (e.key === '/' && document.activeElement !== searchInput && !(dialog && dialog.open)) {
          e.preventDefault();
          searchInput?.focus();
        }
      });

      // L3 Deep-Dive Dialog on Row Click
      rows.forEach(row => {
        row.addEventListener('click', () => {
          const idx = Number(row.getAttribute('data-idx'));
          const g = allGuests[idx];
          if (!g || !dialog) return;

          const statusMap = {
            confirmed: { label: 'Confermato (Form RSVP)', cls: 'pill-ok' },
            maybe: { label: 'In Forse (Form RSVP)', cls: 'pill-warn' },
            verbal: { label: `${g.source} · Manca Form`, cls: 'pill-verbal' },
          };
          const sInfo = statusMap[g.status] || statusMap.confirmed;
          dlgBadge.textContent = sInfo.label;
          dlgBadge.className = `dlg-status-pill ${sInfo.cls}`;
          dlgTitle.textContent = g.nickname ? `«${g.nickname}»` : g.name;
          dlgSubtitle.textContent = g.nickname && g.name ? g.name : (g.city || 'Ospite 50° Palladiano');

          const details = [
            ['Quota', g.plus_ones > 0 ? `1 + ${g.plus_ones} (${g.is_family ? 'Famiglia' : '+1'})` : (g.plus_label_it || '1 persona')],
            ['Città', g.city || 'Non specificata'],
            ['Gruppo / Carovana', g.group || '—'],
            ['Connessioni', g.partner_friend || '—'],
            ['Richiesta Musicale', g.music_note || 'Nessuna'],
            ['Hashtag', g.hashtags.map(t => `#${t}`).join(' ') || '—'],
          ];

          dlgBody.innerHTML = details.map(([k, v]) =>
            `<div class="dlg-row"><span class="dlg-k">${k}</span><span class="dlg-v">${v}</span></div>`
          ).join('');

          dlgFoot.innerHTML = g.status === 'verbal'
            ? `<a href="${publicFormUrl}" target="_blank" rel="noopener noreferrer" class="btn-mini btn-mini-gold">Compila il Form RSVP ora</a>`
            : '';

          dialog.showModal();
        });
      });

      if (dlgClose && dialog) {
        dlgClose.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
      }

      window.addEventListener('popstate', applyUI);
      applyUI();
    })();
  </script>
</Layout>

