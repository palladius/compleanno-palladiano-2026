---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";

const dishes = [
  {
    id: "aria-bosco",
    course_it: "Antipasto Concettuale",
    course_en: "Conceptual Starter",
    badgeColor: "#f59e0b",
    title_it: "Aria di Bosco Ferrarese",
    title_en: "Ferrara Forest Mist",
    subtitle_it: "Emulsionata su Polenta Trasparente",
    subtitle_en: "Emulsified over Transparent Quantum Polenta",
    tagline_it: "Nebbia di Comacchio e rugiada mattutina a impatto karmico negativo.",
    tagline_en: "Comacchio valley fog and dawn dew with negative karmic footprint.",
    image: `${baseUrl}/images/aria_bosco_polenta_trasparente.png`,
    video: `${baseUrl}/videos/aria_bosco_dry_ice.mp4`,
    hasVideo: true,
    story_it: "Nebbia mattutina raccolta con retini di seta nelle pinete secolari di Mesola e del Lido degli Estensi. Emulsionata a ultrasuoni e delicatamente adagiata su un lingotto gelatinoso di polenta invisibile a zero calorie e impatto karmico negativo. Mica pizze e fichi!",
    story_en: "Morning mist captured with handmade silk nets in the ancient pine forests of Mesola and Lido degli Estensi. Ultrasonically emulsified and gently settled on a gelatinous ingot of invisible, zero-calorie, negative-karma polenta. True culinary transcendence!",
    ingredients_it: [
      "🌫️ Brezza Umida delle Valli di Comacchio catturata prima dell'alba.",
      "🌽 Polenta di Mais Trasparente Quantistica a zero calorie.",
      "🌲 Singolo Ago di Pino & Gocce di Rugiada aromatica."
    ],
    ingredients_en: [
      "🌫️ Humid Dawn Breeze from the Comacchio Valleys, ethically trapped before sunrise.",
      "🌽 Quantum Transparent Corn Polenta (0 calories, 100% ether).",
      "🌲 Single Wild Pine Needle & Drops of Aromatic Morning Dew."
    ],
    quote_it: "Bello, leggero... talmente etereo che dopo tre portate hai più fame di prima!",
    quote_en: "Beautiful, light... so ethereal that after three plates you're hungrier than before!",
    author: "Ermete Bottazzi, Camionista & Critico 🚛"
  },
  {
    id: "pizze-fichi",
    course_it: "Antipasto d'Autore",
    course_en: "Signature Starter",
    badgeColor: "#f87171",
    title_it: "Pizze e Fichi di Bottura",
    title_en: "Bottura's Pizza & Figs",
    subtitle_it: "Mica pizze e fichi di Cetto La Qualunque!",
    tagline_it: "Mini margherite fumanti e fichi freschi in scrigno bifasico.",
    subtitle_en: "No ordinary cheap stuff!",
    tagline_en: "Steaming mini margheritas and fresh figs in a dual-chamber box.",
    image: `${baseUrl}/images/pizze_e_fichi_vegetariano.png`,
    hasVideo: false,
    story_it: "Omaggio concettuale irriverente all'alta cucina emiliana per gli ospiti vegetariani non-vegani. Uno scrigno diviso rigidamente a metà: da un lato la fragranza del fiordilatte filante, dall'altro la dolcezza ancestrale del fico fresco. Zero contaminazione!",
    story_en: "An irreverent conceptual tribute to high Emilian cuisine for vegetarian non-vegan guests. A rigid two-compartment case: stringy melted fiordilatte fragrance on one side, ancestral fresh fig sweetness on the other. Strict zero-cross-contamination!",
    ingredients_it: [
      "🍕 Mini Pizzette Margherita calde con mozzarella fiordilatte e basilico.",
      "🍇 Fichi Freschi di Raccolta neri e verdi tagliati a metà con nettare naturale.",
      "🙅‍♂️ Separatore Molecolare: i fichi non toccano la pizza prima del morso."
    ],
    ingredients_en: [
      "🍕 Piping hot mini Margherita pizzas with artisanal fiordilatte & fresh basil.",
      "🍇 Freshly picked Black & Green Figs split open to release natural nectar.",
      "🙅‍♂️ Molecular Barrier: figs strictly never touch pizza before the first bite."
    ],
    quote_it: "Dicevano 'Mica pizze e fichi!'... e infatti queste sono le Pizze e Fichi di Bottura, mica roba da quattro soldi!",
    quote_en: "They used to say 'Not just pizza and figs!'... and indeed this is Bottura-grade pizza & figs, not cheap street food!",
    author: "Ermete Bottazzi, Filosofo della Strada 🚛"
  },
  {
    id: "veganiga",
    course_it: "Primo Piatto D.O.P.",
    course_en: "First Course D.O.P.",
    badgeColor: "#10b981",
    title_it: "Bigoli con la Veganiga",
    title_en: "Bigoli with Lugano Veganiga",
    subtitle_it: "La Vera Salsiccia Verde di Lugano",
    subtitle_en: "The Genuine Emerald Sausage of Lake Ceresio",
    tagline_it: "100% bio-ingegneria ticinese insaccata a mano.",
    tagline_en: "100% Ticino bio-engineering, tenderly hand-stuffed.",
    image: `${baseUrl}/images/bigoli_con_veganiga.png`,
    hasVideo: false,
    story_it: "La leggendaria salsiccia vegetale verde smeraldo del Ceresio, insaccata rigorosamente a mano senza alcuno stress emotivo per i broccoli alpini. Un capolavoro ticinese di bio-ingegneria che sfida la norcineria tradizionale.",
    story_en: "The legendary emerald-green vegan sausage of Lake Lugano, hand-stuffed with zero emotional stress caused to alpine broccoli. A Ticino bio-engineering masterpiece redefining traditional charcuterie.",
    ingredients_it: [
      "🥦 Cimette di Broccolo & Cavolfiore Alpino stufate al vapore.",
      "🥒 Cetrioli Fermentati a Freddo per una croccantezza rinfrescante.",
      "🫚 Zenzero Bio-Dinamico & Aria del Monte Brè in budello vegetale."
    ],
    ingredients_en: [
      "🥦 Steamed Alpine Broccoli & Cauliflower Florets.",
      "🥒 Cold-Fermented Cucumbers for signature crisp bite.",
      "🫚 Biodynamic Ginger & Monte Brè Alpine Air encased in vegetal cellulose casing."
    ],
    quote_it: "Sembra una luganiga, sa di orto sinergico, ma se ci bevi sopra sembra quasi un miracolo!",
    quote_en: "Looks like pork sausage, tastes like a synergetic permaculture garden, but wash it down with wine and it's a miracle!",
    author: "Ermete Bottazzi, Camionista & Gourmet 🚛"
  },
  {
    id: "tofu-maremma",
    course_it: "Secondo • In Odor di Toscana 🍷",
    course_en: "Main • Strictly In Odor di Toscana 🍷",
    badgeColor: "#10b981",
    title_it: "Stracotto di Tofu di Maremma",
    title_en: "Braised Maremma Tofu Stew",
    subtitle_it: "Coltivato vicino a Mucche Ignare 🐮",
    subtitle_en: "Grown in direct sight of completely Oblivious Cows 🐮",
    tagline_it: "Cubi di tofu sbocciati nei campi toscani stufati al Chianti.",
    tagline_en: "Tofu cubes blossoming on Tuscan shrubs, braised in Chianti reduction.",
    image: `${baseUrl}/images/tofu_maremma_mucche_ignare.png`,
    hasVideo: false,
    story_it: "Coltivato direttamente sui cespugli biologici della Maremma toscana, dove i cubi di tofu bianco fioriscono spontaneamente sotto il sole caldo mentre le mucche chianine pascolano pacifiche e completamente ignare sullo sfondo. Coccolato con musica classica e stufato in riduzione di Chianti e rosmarino di Bolgheri.",
    story_en: "Harvested directly from wild organic tofu shrubs in the Tuscan Maremma, where snow-white tofu cubes bloom spontaneously under the sun while Chianina cows graze peacefully and completely oblivious in the background. Braised gently in Chianti Classico reduction and Bolgheri wild rosemary.",
    ingredients_it: [
      "🌱 Piante di Tofu da Arbusto Spontaneo raccolte a perfetta maturazione cubica.",
      "🐮 Mucche 100% Ignare che pascolano indisturbate sullo sfondo.",
      "🌿 Aromi di Bolgheri & Chianti: Strictly In Odor di Toscana."
    ],
    ingredients_en: [
      "🌱 Wild-harvested Shrub Tofu picked at peak geometric cubic ripeness.",
      "🐮 100% Oblivious Cows roaming undisturbed on scenic pasture hills.",
      "🌿 Chianti Wine Reduction & Wild Bolgheri Rosemary: Strictly In Odor di Toscana."
    ],
    quote_it: "Se le mucche sapessero cosa stiamo mangiando, si farebbero una risata anche loro!",
    quote_en: "If the cows actually knew what we were eating instead of them, they'd burst into laughter too!",
    author: "Ermete Bottazzi, Gourmet di Bordo 🚛"
  },
  {
    id: "tiramisu",
    course_it: "Dessert Molecolare",
    course_en: "Molecular Dessert",
    badgeColor: "#fbbf24",
    title_it: "Tiramisù allo Struzzo Vegano",
    title_en: "Vegan Ostrich Tiramisù",
    subtitle_it: "Con Finto Tuorlo Gigante Sinergico",
    subtitle_en: "With Giant Synergetic Plant-Based Yolk",
    tagline_it: "Sembra irresistibile finché non leggi la scheda tecnica...",
    tagline_en: "Looks irresistible until you read the biochemical datasheet...",
    image: `${baseUrl}/images/tiramisu_struzzo_vegano.png`,
    hasVideo: false,
    story_it: "Alla vista sembra un peccato di gola irresistibile: crema spumosa, biscotto soffice, polvere vellutata e un tuorlo dorato gigante che sembra zabaione colante purissimo. Ma non farti ingannare dagli occhi... la biochimica vegetale qui ha superato ogni limite morale.",
    story_en: "To the eyes it appears as an irresistible culinary sin: frothy cream, pillowy sponge, velvety cocoa dust, and a mammoth golden yolk that resembles dripping zabaione. But do not let your sight fool you... botanical bio-engineering has crossed all known moral frontiers.",
    ingredients_it: [
      "🥚 Finto Tuorlo di Struzzo: sferificazione di rapa gialla fermentata all'aglio dolce, spirulina e cannellini.",
      "🥛 Spuma di Mascarpone: emulsione di sego di cavolfiore al vapore di cipolla e latte di soia grezzo.",
      "🥖 Savoiardi Ancestrali: crusca di lenticchie nere e semi di lino inzuppati in decotto di carciofo e tarassaco.",
      "🍫 Spolvero di Cacao: carbone vegetale attivo da rami di melanzana bruciati."
    ],
    ingredients_en: [
      "🥚 Mock Ostrich Yolk: spherified fermented yellow turnip with sweet garlic, spirulina & white cannellini beans.",
      "🥛 Mascarpone Cloud: emulsion of cauliflower curd over onion steam and raw organic soy milk.",
      "🥖 Ancestral Ladyfingers: black lentil bran & flaxseeds soaked in artichoke & dandelion herbal broth.",
      "🍫 Cocoa Dust Illusion: activated vegetable charcoal from charred heirloom eggplant branches."
    ],
    quote_it: "Bello da fotografare per Instagram... poi dai la prima cucchiaiata e capisci perché le galline si sono rifiutate di collaborare!",
    quote_en: "Gorgeous to shoot for Instagram... then you take the first spoonful and realize why hens refused to participate!",
    author: "Ermete Bottazzi, Critico Gastronomico 🚛"
  }
];
---

<Layout title="Menu d'Avanguardia | 50° Compleanno Palladiano 🍽️" currentPage="menu">
  <main class="container">
    <!-- MENU HEADER -->
    <header class="section-header">
      <span class="tag-green">🌱 BANQUETTO D'AVANGUARDIA CRUELTY-FREE</span>
      <h1 class="page-title">
        <span lang-it>Il Menu Ufficiale: Dalla Veganiga alla Nebbia Ferrarese</span>
        <span lang-en>The Official Menu: From Veganiga to Ferrara Fog</span>
      </h1>
      <p class="section-desc">
        <span lang-it>Clicca su una portata per svelare ingredienti segreti, retroscena biochimici e recensioni senza peli sulla lingua di Ermete Bottazzi.</span>
        <span lang-en>Click on any dish to unveil secret ingredients, biochemical lore, and unfiltered reviews by trucker Ermete Bottazzi.</span>
      </p>
    </header>

    <!-- DISHES GRID -->
    <div class="dishes-grid">
      {dishes.map((dish) => (
        <div 
          class={`dish-card ${dish.hasVideo ? 'hover-video-card' : ''}`}
          data-dish-id={dish.id}
        >
          <div class="card-img-wrapper">
            <img src={dish.image} alt={dish.title_it} class="card-img" />
            {dish.hasVideo && (
              <video 
                src={dish.video} 
                loop 
                muted 
                playsinline 
                class="card-video"
              ></video>
            )}
            <span class="card-badge" style={`color: ${dish.badgeColor}; border-color: ${dish.badgeColor};`}>
              <span lang-it>{dish.course_it}</span>
              <span lang-en>{dish.course_en}</span>
            </span>
            {dish.hasVideo && (
              <span class="video-indicator">🎬 Video Veo</span>
            )}
          </div>

          <div class="card-content">
            <h3 class="card-title">
              <span lang-it>{dish.title_it}</span>
              <span lang-en>{dish.title_en}</span>
            </h3>
            <h4 class="card-subtitle">
              <span lang-it>{dish.subtitle_it}</span>
              <span lang-en>{dish.subtitle_en}</span>
            </h4>
            <p class="card-tagline">
              <span lang-it>{dish.tagline_it}</span>
              <span lang-en>{dish.tagline_en}</span>
            </p>
            
            <button class="btn-card-expand">
              <span lang-it>Vedi scheda & ingredienti 🔍</span>
              <span lang-en>View specs & recipe 🔍</span>
            </button>
          </div>
        </div>
      ))}
    </div>


    <!-- HILARIOUS CULINARY WARNING CALLOUT -->
    <div class="culinary-heresy-card">
      <div class="heresy-icon">⚠️🍕</div>
      <div class="heresy-content">
        <h3 lang-it>Vedrai Cose Mai Viste Prima...</h3>
        <h3 lang-en>You'll See Things Unseen Before...</h3>
        <p lang-it>
          Un avvertimento solenne per tutti i puristi della gastronomia italiana: preparati a sfide culinarie d'avanguardia che potrebbero spingerti a <em>"rinunciare alla cittadinanza italiana"</em>! 🇮🇹🙅‍♂️
        </p>
        <p lang-en>
          A solemn warning for all Italian food purists: get ready for avant-garde culinary heresies so extreme they might tempt you to <em>"renounce your Italian citizenship"</em>! 🇮🇹🙅‍♂️
        </p>
        <div class="heresy-action">
          <a href="https://www.youtube.com/watch?v=ypUPVMRJeJM" target="_blank" rel="noopener noreferrer" class="btn btn-warning-yt">
            <span class="yt-icon">▶️</span>
            <span lang-it>Guarda l'anteprima scioccante su YouTube 🎬</span>
            <span lang-en>Watch the shocking preview on YouTube 🎬</span>
          </a>
        </div>
      </div>
    </div>

    <!-- WINE & BEVERAGES CALLOUT -->
    <div class="beverage-card">
      <div class="beverage-icon">🍷</div>
      <div class="beverage-info">
        <h3 lang-it>La Cantina: Strictly "In Odor di Toscana"</h3>
        <h3 lang-en>The Cellar: Strictly "In Odor di Toscana"</h3>
        <p lang-it>
          Fiumi di Chianti Classico Riserva, Bolgheri DOC, Prosecco Superiore di Valdobbiadene e un tocco di Lambrusco frizzante di Modena per sgrassare la Veganiga di Lugano!
        </p>
        <p lang-en>
          Rivers of Chianti Classico Riserva, Bolgheri DOC, Prosecco Superiore from Valdobbiadene, and a splash of sparkling Lambrusco from Modena to cut through the Lugano Veganiga!
        </p>
      </div>
    </div>

    <!-- RSVP BUTTON -->
    <div class="menu-cta">
      <a href={publicFormUrl} target="_blank" class="btn btn-primary">
        <span lang-it>Il Menu ti ha convinto? Conferma Presenza (RSVP) ✍️</span>
        <span lang-en>Craving this feast? Confirm RSVP ✍️</span>
      </a>
      <a href={`${baseUrl}/`} class="btn btn-secondary">
        <span lang-it>Torna al Programma ⏰</span>
        <span lang-en>Back to Schedule ⏰</span>
      </a>
    </div>

    <!-- DISH DETAIL MODAL (LIGHTBOX) -->
    <div id="dishModal" class="dish-modal" aria-hidden="true">
      <div class="dish-modal-backdrop" id="modalBackdrop"></div>
      <div class="dish-modal-container">
        <button class="dish-modal-close" id="modalClose" aria-label="Close">&times;</button>
        
        <div class="modal-media-wrapper" id="modalMediaWrapper">
          <img id="modalImg" src="" alt="" class="modal-media" />
          <video id="modalVid" src="" controls autoplay loop playsinline class="modal-media" style="display: none;"></video>
        </div>

        <div class="modal-body">
          <span class="modal-badge" id="modalBadge"></span>
          <h2 class="modal-title" id="modalTitle"></h2>
          <h4 class="modal-subtitle" id="modalSubtitle"></h4>
          <p class="modal-story" id="modalStory"></p>

          <div class="modal-ingredients">
            <h4 lang-it>🌿 Scheda Tecnica & Ingredienti:</h4>
            <h4 lang-en>🌿 Technical Specs & Ingredients:</h4>
            <ul id="modalIngredientsList"></ul>
          </div>

          <div class="modal-quote" id="modalQuoteWrapper">
            <em id="modalQuoteText"></em>
            <div class="modal-quote-author" id="modalQuoteAuthor"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ dishes }}>
    // Hover video preview for cards
    document.querySelectorAll('.hover-video-card').forEach(card => {
      const vid = card.querySelector('video');
      if (vid) {
        card.addEventListener('mouseenter', () => { vid.play().catch(() => {}); });
        card.addEventListener('mouseleave', () => { vid.pause(); vid.currentTime = 0; });
      }
    });

    // Modal Details Logic
    const modal = document.getElementById('dishModal');
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalClose = document.getElementById('modalClose');
    const modalImg = document.getElementById('modalImg');
    const modalVid = document.getElementById('modalVid');
    const modalBadge = document.getElementById('modalBadge');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const modalStory = document.getElementById('modalStory');
    const modalIngredientsList = document.getElementById('modalIngredientsList');
    const modalQuoteText = document.getElementById('modalQuoteText');
    const modalQuoteAuthor = document.getElementById('modalQuoteAuthor');

    function openDishModal(dishId) {
      const dish = dishes.find(d => d.id === dishId);
      if (!dish || !modal) return;

      const currentLang = document.documentElement.getAttribute('data-lang') || 'it';
      const isIt = currentLang === 'it';

      if (dish.hasVideo) {
        modalImg.style.display = 'none';
        modalVid.style.display = 'block';
        modalVid.src = dish.video;
        modalVid.play().catch(() => {});
      } else {
        modalVid.style.display = 'none';
        modalVid.pause();
        modalVid.src = '';
        modalImg.style.display = 'block';
        modalImg.src = dish.image;
        modalImg.alt = isIt ? dish.title_it : dish.title_en;
      }

      modalBadge.innerText = isIt ? dish.course_it : dish.course_en;
      modalBadge.style.color = dish.badgeColor;
      modalBadge.style.borderColor = dish.badgeColor;

      modalTitle.innerText = isIt ? dish.title_it : dish.title_en;
      modalSubtitle.innerText = isIt ? dish.subtitle_it : dish.subtitle_en;
      modalStory.innerText = isIt ? dish.story_it : dish.story_en;

      modalIngredientsList.innerHTML = '';
      const ings = isIt ? dish.ingredients_it : dish.ingredients_en;
      ings.forEach(ing => {
        const li = document.createElement('li');
        li.innerText = ing;
        modalIngredientsList.appendChild(li);
      });

      modalQuoteText.innerText = `"${isIt ? dish.quote_it : dish.quote_en}"`;
      modalQuoteAuthor.innerText = `— ${dish.author}`;

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDishModal() {
      if (!modal) return;
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      if (modalVid) {
        modalVid.pause();
        modalVid.src = '';
      }
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.dish-card').forEach(card => {
      card.addEventListener('click', () => {
        const dishId = card.getAttribute('data-dish-id');
        if (dishId) openDishModal(dishId);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeDishModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeDishModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeDishModal();
      }
    });
  </script>
</Layout>

<style>
  .page-title {
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: 0.8rem;
    color: var(--text-light);
  }

  /* DISHES GRID */
  .dishes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 3.5rem;
  }

  .dish-card {
    background: var(--bg-card);
    border-radius: 22px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }

  .dish-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-gold);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.55);
  }

  .card-img-wrapper {
    position: relative;
    width: 100%;
    height: 230px;
    overflow: hidden;
    background: #000;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .dish-card:hover .card-img {
    transform: scale(1.05);
  }

  .card-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }

  .dish-card:hover .card-video {
    opacity: 1;
  }

  .card-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(8px);
    font-weight: 800;
    font-size: 0.75rem;
    padding: 0.3rem 0.75rem;
    border-radius: 8px;
    border: 1px solid;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .video-indicator {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(0, 0, 0, 0.75);
    color: var(--accent-gold);
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
  }

  .card-content {
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    font-size: 1.45rem;
    color: var(--accent-gold);
    margin-bottom: 0.35rem;
    line-height: 1.25;
  }

  .card-subtitle {
    font-size: 0.98rem;
    color: var(--text-light);
    margin-bottom: 0.7rem;
    font-weight: 600;
  }

  .card-tagline {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-bottom: 1.4rem;
    line-height: 1.45;
    flex-grow: 1;
  }

  .btn-card-expand {
    background: rgba(245, 158, 11, 0.12);
    color: var(--accent-gold);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 0.65rem 1rem;
    border-radius: 10px;
