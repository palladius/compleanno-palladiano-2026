---
import Layout from '../layouts/Layout.astro';
import CircularProgress from '../components/CircularProgress.astro';
import fomoStats from '../data/fomo.json';

const citiesEntries = Object.entries(fomoStats.cities || {});
citiesEntries.sort((a, b) => (b[1] as number) - (a[1] as number));
const maxCityCount = citiesEntries.length > 0 ? Math.max(...citiesEntries.map(e => e[1] as number)) : 1;
---

<Layout title="Statistiche | Il 50° Compleanno Palladiano" currentPage="stats">
  <main class="container">
    <section class="section">
      <div class="section-header">
        <span class="tag-gold">📊 RSVP & FOMO STATS</span>
        <h2 lang-it>Statistiche in Tempo Reale</h2>
        <h2 lang-en>Real-Time Statistics</h2>
        <p class="section-desc">
          <span lang-it>Situazione aggiornata dei posti disponibili per la cena e per il pernottamento.</span>
          <span lang-en>Current status of available seats for dinner and overnight accommodation.</span>
        </p>
      </div>

      <div class="stats-grid">
        <!-- RISPOSTE -->
        <div class="stat-card">
          <div class="stat-icon">📝</div>
          <h3 lang-it>Moduli Inviati</h3>
          <h3 lang-en>Form Responses</h3>
          <div class="stat-numbers">
            <div class="stat-row">
              <span class="stat-val">{fomoStats.respondents}</span>
              <span class="stat-lbl" lang-it>Si, ci saro!</span>
              <span class="stat-lbl" lang-en>Yes, I&apos;ll be there</span>
            </div>
            <div class="stat-row">
              <span class="stat-val">{fomoStats.maybe_respondents}</span>
              <span class="stat-lbl" lang-it>In Forse</span>
              <span class="stat-lbl" lang-en>Maybe</span>
            </div>
            <div class="stat-row highlight">
              <span class="stat-val">{fomoStats.respondents + fomoStats.maybe_respondents}</span>
              <span class="stat-lbl" lang-it>Totale Risposte</span>
              <span class="stat-lbl" lang-en>Total Responses</span>
            </div>
          </div>
        </div>

        <!-- RISTORANTE -->
        <div class="stat-card">
          <div class="stat-icon">🍽️</div>
          <h3 lang-it>Al Ristorante</h3>
          <h3 lang-en>At the Restaurant</h3>
          <CircularProgress 
            value={fomoStats.confirmed} 
            max={fomoStats.total_seats} 
            labelIt="Pienezza" 
            labelEn="Occupancy"
            color="#f59e0b"
          />
          <div class="stat-numbers">
            <div class="stat-row">
              <span class="stat-val">{fomoStats.confirmed}</span>
              <span class="stat-lbl" lang-it>Ospiti Confermati</span>
              <span class="stat-lbl" lang-en>Confirmed Guests</span>
            </div>
            <div class="stat-row">
              <span class="stat-val">{fomoStats.maybe}</span>
              <span class="stat-lbl" lang-it>In Forse</span>
              <span class="stat-lbl" lang-en>Maybe</span>
            </div>
            <div class="stat-row highlight">
              <span class="stat-val">{fomoStats.rompicoglioni}</span>
              <span class="stat-lbl" lang-it>Diete Particolari (Celiaci: {fomoStats.dietary_breakdown.celiaci}, Vegani: {fomoStats.dietary_breakdown.vegani}, Vegetariani: {fomoStats.dietary_breakdown.vegetariani}, Altro: {fomoStats.dietary_breakdown.altro}) 🥦</span>
              <span class="stat-lbl" lang-en>Special Diets (Celiacs: {fomoStats.dietary_breakdown.celiaci}, Vegans: {fomoStats.dietary_breakdown.vegani}, Vegetarians: {fomoStats.dietary_breakdown.vegetariani}, Other: {fomoStats.dietary_breakdown.altro}) 🥦</span>
            </div>
            <div class="stat-row">
              <span class="stat-val">{fomoStats.total_seats}</span>
              <span class="stat-lbl" lang-it>Capienza Massima</span>
              <span class="stat-lbl" lang-en>Total Capacity</span>
            </div>
            <div class="stat-row highlight">
              <span class="stat-val">{fomoStats.total_seats - fomoStats.confirmed}</span>
              <span class="stat-lbl" lang-it>Posti Liberi (su {fomoStats.total_seats})</span>
              <span class="stat-lbl" lang-en>Seats Left (out of {fomoStats.total_seats})</span>
            </div>
          </div>
        </div>

        <!-- DORMIRE -->
        <div class="stat-card">
          <div class="stat-icon">🛏️</div>
          <h3 lang-it>Pernottamento</h3>
          <h3 lang-en>Accommodation</h3>
          <CircularProgress 
            value={fomoStats.need_accomodation} 
            max={fomoStats.total_accomodation} 
            labelIt="Pienezza" 
            labelEn="Occupancy"
            color="#3b82f6" 
          />
          <div class="stat-numbers">
            <div class="stat-row">
              <span class="stat-val">{fomoStats.need_accomodation}</span>
              <span class="stat-lbl" lang-it>Posti Prenotati</span>
              <span class="stat-lbl" lang-en>Beds Booked</span>
            </div>
            <div class="stat-row">
              <span class="stat-val">{fomoStats.total_accomodation}</span>
              <span class="stat-lbl" lang-it>Letti Totali</span>
              <span class="stat-lbl" lang-en>Total Beds</span>
            </div>
            <div class="stat-row highlight">
              <span class="stat-val">{fomoStats.total_accomodation - fomoStats.need_accomodation}</span>
              <span class="stat-lbl" lang-it>Letti Rimanenti</span>
              <span class="stat-lbl" lang-en>Beds Left</span>
            </div>
          </div>
        </div>

        <!-- PROVENIENZE -->
        <div class="stat-card" style="grid-column: 1 / -1;">
          <div class="stat-icon">🗺️</div>
          <h3 lang-it>Da dove venite? (Gruppi &gt; 1)</h3>
          <h3 lang-en>Where are you from? (Groups &gt; 1)</h3>
          
          <div class="city-histogram">
            {citiesEntries.map(([city, count]) => (
              <div class="city-bar-row">
                <span class="city-name">{city}</span>
                <div class="city-bar-wrapper">
                  <div class="city-bar" style={`width: ${((count as number) / maxCityCount) * 100}%`}></div>
                </div>
                <span class="city-count">{count}</span>
              </div>
            ))}
            {citiesEntries.length === 0 && (
              <p style="text-align: center; opacity: 0.7;">Ancora nessun gruppo numeroso (N &gt; 1) da una singola città. Aumenta la FOMO!</p>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 2.5rem;
    text-align: center;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    border-color: rgba(245, 158, 11, 0.3);
  }

  .stat-icon {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    filter: drop-shadow(0 4px 10px rgba(245, 158, 11, 0.3));
  }

  .stat-card h3 {
    font-size: 1.8rem;
    color: var(--accent-gold);
    margin-bottom: 1.5rem;
    font-family: 'Playfair Display', serif;
  }

  .stat-numbers {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.8rem 1rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    font-size: 1.1rem;
  }

  .stat-row.highlight {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: var(--accent-gold);
    font-weight: 700;
  }

  .stat-val {
    font-weight: 800;
    font-size: 1.4rem;
  }

  .stat-lbl {
    opacity: 0.9;
  }

  .city-histogram {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
    text-align: left;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }
  .city-bar-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .city-name {
    width: 140px;
    font-weight: bold;
    text-align: right;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .city-bar-wrapper {
    flex-grow: 1;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    height: 24px;
    overflow: hidden;
  }
  .city-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--accent-gold), #d97706);
    border-radius: 6px;
    transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .city-count {
    width: 30px;
    font-weight: bold;
    color: var(--accent-gold);
  }
</style>
