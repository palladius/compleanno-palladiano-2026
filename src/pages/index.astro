---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";
---

<Layout title="50 Sfumature di Giallo | Il 50° Compleanno Palladiano 💛" currentPage="home">
  <main class="container">
    <!-- HERO SECTION -->
    <header class="hero">
      <div class="birthday-avatar-wrapper">
        <div class="badge-super">
          <span lang-it>💛 50 SFUMATURE DI GIALLO 💛</span>
          <span lang-en>💛 50 SHADES OF YELLOW 💛</span>
        </div>
        <div class="avatar-container">
          <img 
            src={`${baseUrl}/images/riccardo_50_portrait.png`} 
            alt="Riccardo 50 Anni - 50 Sfumature di Giallo" 
            class="birthday-avatar" 
          />
          <div class="avatar-crown-badge">👑 50 & Fabulous</div>
        </div>
        <div class="save-date-row">
          <div class="badge">
            <span lang-it>SAVE THE DATE • MARTEDÌ 29 DICEMBRE 2026</span>
            <span lang-en>SAVE THE DATE • TUESDAY DECEMBER 29, 2026</span>
          </div>
          <a 
            href="https://calendar.google.com/calendar/render?action=TEMPLATE&text=50%C2%B0+Compleanno+Palladiano+%7C+50+Sfumature+di+Giallo+%F0%9F%92%9B&dates=20261229T140000Z/20261229T230000Z&details=50%C2%B0+Compleanno+Palladiano%3A+Mezzo+secolo+di+avventure%2C+codice%2C+bicicletta+e+banchetto+d%27avanguardia%21%0AInfo+complete+e+menu%3A+https%3A%2F%2Fpalladius.github.io%2Fcompleanno-palladiano-2026%2F&location=Bassa+Padana+%28Strictly+In+Odor+di+Toscana%29" 
            target="_blank" 
            class="gcal-btn"
            title="Aggiungi a Google Calendar / Add to Google Calendar"
          >
            <svg class="gcal-icon" viewBox="0 0 24 24" width="14" height="14" fill="currentColor">
              <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2zm-7 5h5v5h-5v-5z"/>
            </svg>
            <span>+ GCal</span>
          </a>
        </div>
      </div>
      <h1 class="hero-title">
        <span lang-it>50 Sfumature <br/><span class="gold-text">di Giallo</span></span>
        <span lang-en>50 Shades <br/><span class="gold-text">of Yellow</span></span>
      </h1>
      <p class="hero-subtitle">
        <span lang-it>
          <strong>Il Cinquantesimo Compleanno Palladiano:</strong> mezzo secolo di avventure, codice, bicicletta, cappelletti e... scelte gastronomiche d'avanguardia.
        </span>
        <span lang-en>
          <strong>The Palladian 50th Birthday:</strong> half a century of adventures, code, cycling, cappelletti, and... avant-garde culinary experiments.
        </span>
      </p>
      
      <div class="event-meta">
        <div class="meta-item">
          <span class="meta-icon">📅</span>
          <div>
            <strong lang-it>Martedì 29 Dicembre 2026</strong>
            <strong lang-en>Tuesday December 29, 2026</strong>
            <small lang-it>Dalle 15:00 (check-in) / 18:00 (aperitivo) a mezzanotte</small>
            <small lang-en>From 15:00 (early check-in) / 18:00 (cocktail) till midnight</small>
          </div>
        </div>
        <div class="meta-item">
          <span class="meta-icon">📍</span>
          <div>
            <strong lang-it>Location Segreta / Bassa Padana</strong>
            <strong lang-en>Secret Location / Po Valley</strong>
            <small>Strictly "In Odor di Toscana" 🍷</small>
          </div>
        </div>
      </div>

      <!-- COUNTDOWN -->
      <div class="countdown-wrapper">
        <div class="countdown-box">
          <span id="days" class="countdown-val">--</span>
          <span class="countdown-lbl"><span lang-it>Giorni</span><span lang-en>Days</span></span>
        </div>
        <div class="countdown-box">
          <span id="hours" class="countdown-val">--</span>
          <span class="countdown-lbl"><span lang-it>Ore</span><span lang-en>Hours</span></span>
        </div>
        <div class="countdown-box">
          <span id="minutes" class="countdown-val">--</span>
          <span class="countdown-lbl"><span lang-it>Minuti</span><span lang-en>Minutes</span></span>
        </div>
        <div class="countdown-box">
          <span id="seconds" class="countdown-val">--</span>
          <span class="countdown-lbl"><span lang-it>Secondi</span><span lang-en>Seconds</span></span>
        </div>
      </div>

      <div class="hero-cta">
        <a href={`${baseUrl}/#programma`} class="btn btn-primary">
          <span lang-it>Il Programma della Serata ⏰</span>
          <span lang-en>Evening Schedule ⏰</span>
        </a>
        <span class="btn btn-secondary btn-badge-coming">
          <span lang-it>🍽️ Menu in Arrivo ⏳</span>
          <span lang-en>🍽️ Menu Coming Soon ⏳</span>
        </span>
        <a href={publicFormUrl} target="_blank" class="btn btn-primary">
          <span lang-it>Conferma Presenza (RSVP) ✍️</span>
          <span lang-en>RSVP (Google Form) ✍️</span>
        </a>
      </div>
    </header>

    <!-- PROGRAMMA DELLA SERATA (DEFAULT SECTION) -->
    <section id="programma" class="section">
      <div class="section-header">
        <span class="tag-gold">⏰ IL PROGRAMMA UFFICIALE • TIMELINE</span>
        <h2 lang-it>Cosa si fa il 29 Dicembre?</h2>
        <h2 lang-en>What's the Plan on December 29?</h2>
        <p class="section-desc">
          <span lang-it>Un fitto calendario di celebrazioni per il mezzo secolo di Riccardo. Dalla doccia rigenerante al gran finale!</span>
          <span lang-en>A celebration-packed schedule for Riccardo's half-century milestone. From the freshen-up session to the epic finale!</span>
        </p>
      </div>

      <div class="timeline">
        <!-- 15:00 OPZIONALE -->
        <div class="timeline-item optional-item">
          <div class="time-badge optional-badge">
            <span class="time">15:00</span>
            <span class="opt-tag" lang-it>[OPZIONALE]</span>
            <span class="opt-tag" lang-en>[OPTIONAL]</span>
          </div>
          <div class="timeline-content">
            <h3 lang-it>Molla lo Zaino, Doccia & Relax: Sento la puzza di ascelle fin da Zurigo! 🎒🚿</h3>
            <h3 lang-en>Drop the Backpack, Shower & Relax: I can smell armpits from Zurich! 🎒🚿</h3>
            <p lang-it>
              <strong>Per chi arriva da lontano:</strong> fai il check-in nella tua stanza, molla lo zaino sul letto, fatti una bella doccia calda rigenerante, togliti la polvere del viaggio e scendi con tutta calma per l'inizio dell'aperitivo!
            </p>
            <p lang-en>
              <strong>For guests traveling from afar:</strong> check in to your room, drop your luggage, take a refreshing hot shower, shake off the travel dust, and stroll down relaxed just in time for the cocktail hour!
            </p>
            <div class="timeline-quicklink">
              <a href={`${baseUrl}/dormire`}>
                <span lang-it>👉 Vedi opzioni per dormire & logistica</span>
                <span lang-en>👉 See accommodation options & logistics</span>
              </a>
            </div>
          </div>
        </div>

        <!-- 18:00 APERITIVO -->
        <div class="timeline-item">
          <div class="time-badge">
            <span class="time">18:00</span>
          </div>
          <div class="timeline-content">
            <h3 lang-it>Inizio Aperitivo & Accoglienza 🍸</h3>
            <h3 lang-en>Welcome Cocktail & Aperitivo 🍸</h3>
            <p lang-it>
              Accoglienza ospiti, inalazione ufficiale dell'<em>Aria di Bosco Ferrarese</em>, calici di bollicine, stuzzichini e prime battute sul karma vegetale.
            </p>
            <p lang-en>
              Guest arrival, official inhalation of the <em>Ferrara Forest Air</em>, sparkling toast, appetizers, and introductory laughs on botanical karma.
            </p>
          </div>
        </div>

        <!-- 19:45 CENA -->
        <div class="timeline-item">
          <div class="time-badge">
            <span class="time">19:45</span>
          </div>
          <div class="timeline-content">
            <h3 lang-it>La Grande Cena Palladiana 🍝</h3>
            <h3 lang-en>The Grand Palladian Dinner 🍝</h3>
            <p lang-it>
              Servizio solenne dei <em>Bigoli con la Veganiga di Lugano</em>, <em>Stracotto di Tofu di Maremma</em> (strictly con mucche ignare) e Chianti a fiumi.
            </p>
            <p lang-en>
              Ceremonial serving of <em>Bigoli with Veganiga Sausage from Lugano</em>, <em>Maremma Braised Tofu</em> (strictly overlooking oblivious cows), and endless Chianti.
            </p>
            <div class="timeline-quicklink">
              <span class="text-coming-soon">
                <span lang-it>🍽️ <em>Il menu ufficiale del banchetto è in fase di definizione (in arrivo a breve!)</em></span>
                <span lang-en>🍽️ <em>The official banquet menu is currently being curated (coming soon!)</em></span>
              </span>
            </div>
          </div>
        </div>

        <!-- 21:45 DOPOCENA & ROCK -->
        <div class="timeline-item">
          <div class="time-badge">
            <span class="time">21:45</span>
          </div>
          <div class="timeline-content">
            <h3 lang-it>Tiramisù allo Struzzo Vegano & Rock '80 🎸</h3>
            <h3 lang-en>Vegan Ostrich Tiramisù & 80s Rock 🎸</h3>
            <p lang-it>
              Taglio del Tiramisù con finto tuorlo gigante di struzzo sinergico, brindisi toscani, discorsi semi-seri e colonna sonora epica anni '80 con spade laser e draghi.
            </p>
            <p lang-en>
              Cutting of the Tiramisù with giant synergetic ostrich egg yolk, toasts, speeches, and an epic 80s rock soundtrack with lightsabers and dragons.
            </p>
          </div>
        </div>

        <!-- 24:00 CHIUSURA -->
        <div class="timeline-item">
          <div class="time-badge">
            <span class="time">24:00</span>
          </div>
          <div class="timeline-content">
            <h3 lang-it>Tutti Fuori Dalle Balle! 🚛💨</h3>
            <h3 lang-en>Everybody Out & Goodnight! 🚛💨</h3>
            <p lang-it>
              Chiusura cancelli, abbracci calorosi, foto ricordo e rientro nelle proprie dimore prima che scatti il coprifuoco del camionista.
            </p>
            <p lang-en>
              Gates closing, warm farewells, group photos, and safe journeys back before the trucker curfew takes effect!
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- HIGHLIGHTS SECTION -->
    <section class="section alt-bg">
      <div class="section-header">
        <span class="tag-green">✨ GUIDA RAPIDA ALL'EVENTO</span>
        <h2 lang-it>Tutto Quel che Devi Sapere</h2>
        <h2 lang-en>Everything You Need to Know</h2>
      </div>

      <div class="highlights-grid">
        <div class="highlight-card">
          <div class="card-icon">🍽️</div>
          <h3 lang-it>Menu & Banchetto</h3>
          <h3 lang-en>Banquet & Menu</h3>
          <p lang-it>Il menu ufficiale del cinquantesimo è attualmente in fase di composizione con gli chef. Sarà pubblicato a breve su questa pagina!</p>
          <p lang-en>The official 50th birthday menu is currently being finalized with the chefs. It will be released right here soon!</p>
          <span class="card-link-muted">
            <span lang-it>⏳ Menu in arrivo...</span>
            <span lang-en>⏳ Menu coming soon...</span>
          </span>
        </div>

        <div class="highlight-card">
          <div class="card-icon">🛏️</div>
          <h3 lang-it>Dormire & Logistica</h3>
          <h3 lang-en>Stay & Accommodation</h3>
          <p lang-it>Info su Albergo Ai Dossi, assegnazione dei 25 posti letto gratuiti per chi viene da lontano e check-in alle 15:00.</p>
          <p lang-en>Info on Albergo Ai Dossi, 25 free beds for long-distance travelers, and early check-in at 15:00.</p>
          <a href={`${baseUrl}/dormire`} class="card-link">
            <span lang-it>Info Alloggi 🛏️</span>
            <span lang-en>Lodging Info 🛏️</span>
          </a>
        </div>

        <div class="highlight-card">
          <div class="card-icon">❓</div>
          <h3 lang-it>Domande Frequenti (FAQ)</h3>
          <h3 lang-en>Frequent Questions (FAQ)</h3>
          <p lang-it>Vengo da solo o in famiglia? Vale la pena farsi il viaggio? Risposte chiare, accoglienti e senza filtri.</p>
          <p lang-en>Coming solo or with family? Is the journey worth it? Thoughtful, warm, and open-hearted answers.</p>
          <a href={`${baseUrl}/faq`} class="card-link">
            <span lang-it>Leggi le FAQ ❓</span>
            <span lang-en>Read FAQs ❓</span>
          </a>
        </div>

        <div class="highlight-card">
          <div class="card-icon">✉️</div>
          <h3 lang-it>Contatta Riccardo</h3>
          <h3 lang-en>Contact Riccardo</h3>
          <p lang-it>Hai esigenze alimentari, domande logistiche o vuoi mandare un saluto? Scrivigli direttamente via email o form rapido.</p>
          <p lang-en>Got dietary needs, travel questions, or special wishes? Contact Riccardo directly via email or fast form.</p>
          <a href={`${baseUrl}/contatti`} class="card-link">
            <span lang-it>Scrivi a Riccardo ✉️</span>
            <span lang-en>Contact Page ✉️</span>
          </a>
        </div>
      </div>
    </section>

    <!-- RSVP SECTION -->
    <section id="rsvp" class="section">
      <div class="rsvp-card">
        <span class="tag-gold">✍️ MODULO DI CONFERMA</span>
        <h2 lang-it>Sei dei Nostri?</h2>
        <h2 lang-en>Will You Join Us?</h2>
        <p lang-it>
          Compila il modulo ufficiale Google Form per farci sapere se verrai, quanti sarete e se il tuo apparato digerente è pronto alla sfida gastronomica del secolo.
        </p>
        <p lang-en>
          Fill out the official Google RSVP Form to let us know if you are coming, party size, and whether your palate is prepared for the century's avant-garde feast!
        </p>
        
        <div style="margin-top: 2rem;">
          <a href={publicFormUrl} target="_blank" class="btn btn-primary" style="font-size: 1.15rem; padding: 1.1rem 2.2rem;">
            <span lang-it>Compila il Google Form Ufficiale (RSVP) 📝✨</span>
            <span lang-en>Fill out the Official RSVP Form 📝✨</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // Live Countdown
    const targetDate = new Date("2026-12-29T18:00:00+01:00").getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = targetDate - now;

      const daysEl = document.getElementById("days");
      const hoursEl = document.getElementById("hours");
      const minEl = document.getElementById("minutes");
      const secEl = document.getElementById("seconds");

      if (!daysEl || !hoursEl || !minEl || !secEl) return;

      if (distance < 0) {
        daysEl.innerText = "0";
        hoursEl.innerText = "0";
        minEl.innerText = "0";
        secEl.innerText = "0";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      daysEl.innerText = days;
      hoursEl.innerText = hours;
      minEl.innerText = minutes;
      secEl.innerText = seconds;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 3rem 1rem 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .birthday-avatar-wrapper {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge-super {
    display: inline-block;
    padding: 0.5rem 1.6rem;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    border-radius: 9999px;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 1.6rem;
    box-shadow: 0 0 25px rgba(245, 158, 11, 0.5);
    text-transform: uppercase;
  }

  .avatar-container {
    position: relative;
    width: 280px;
    height: 280px;
    margin-bottom: 1.8rem;
  }

  .birthday-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--accent-gold);
    box-shadow: 0 0 40px rgba(245, 158, 11, 0.55);
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .birthday-avatar:hover {
    transform: scale(1.04);
    box-shadow: 0 0 50px rgba(245, 158, 11, 0.8);
  }

  .avatar-crown-badge {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid var(--accent-gold);
    color: var(--accent-gold);
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 4px 15px rgba(0,0,0,0.6);
  }


  .save-date-row {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .gcal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.38rem 0.75rem;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .gcal-btn:hover {
    background: var(--accent-gold);
    color: #0f172a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.4);
  }

  .gcal-icon {
    flex-shrink: 0;
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-gold);
    border: 1px solid var(--accent-gold);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .event-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--bg-card);
    padding: 0.8rem 1.4rem;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    text-align: left;
  }

  .meta-icon {
    font-size: 1.8rem;
  }

  .meta-item strong {
    display: block;
    font-size: 1rem;
  }

  .meta-item small {
    color: var(--text-muted);
  }

  /* COUNTDOWN */
  .countdown-wrapper {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0 2.5rem;
    flex-wrap: wrap;
  }

  .countdown-box {
    background: var(--bg-card);
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 1rem 1.5rem;
    border-radius: 16px;
    min-width: 95px;
    text-align: center;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
  }

  .countdown-val {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--accent-gold);
    display: block;
    line-height: 1;
    font-family: 'Playfair Display', serif;
  }

  .countdown-lbl {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-top: 0.4rem;
    display: block;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* TIMELINE */
  .timeline {
    max-width: 750px;
    margin: 0 auto;
    position: relative;
    border-left: 2px solid rgba(245, 158, 11, 0.3);
    padding-left: 2.2rem;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 3rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -2.68rem;
    top: 0.25rem;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-gold);
    box-shadow: 0 0 12px var(--accent-gold);
  }

  .timeline-item.optional-item::before {
    background: var(--accent-blue);
    box-shadow: 0 0 12px var(--accent-blue);
  }

  .time-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
  }

  .time {
    font-weight: 800;
    color: var(--accent-gold);
    font-size: 1.3rem;
    font-family: 'Playfair Display', serif;
  }

  .optional-badge .time {
    color: var(--accent-blue);
  }

  .opt-tag {
    background: rgba(56, 189, 248, 0.18);
    border: 1px solid var(--accent-blue);
    color: var(--accent-blue);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.15rem 0.55rem;
    border-radius: 9999px;
    letter-spacing: 1px;
  }

  .timeline-content {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.6rem 1.8rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
  }

  .optional-item .timeline-content {
    border-color: rgba(56, 189, 248, 0.35);
    background: rgba(15, 23, 42, 0.7);
  }

