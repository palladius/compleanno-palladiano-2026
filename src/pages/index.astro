---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";
---

<Layout title="50° Compleanno Palladiano | 29 Dicembre 2026">
  <main class="container">
    <!-- HERO SECTION -->
    <header class="hero">
      <div class="badge">SAVE THE DATE • 50 ANNI</div>
      <h1 class="hero-title">Il Cinquantesimo <br/><span class="gold-text">Palladiano</span></h1>
      <p class="hero-subtitle">
        Mezzo secolo di avventure, codice, bicicletta, cappelletti e... scelte gastronomiche d'avanguardia.
      </p>
      
      <div class="event-meta">
        <div class="meta-item">
          <span class="meta-icon">📅</span>
          <div>
            <strong>Martedì 29 Dicembre 2026</strong>
            <small>Dalle ore 18:00 a mezzanotte</small>
          </div>
        </div>
        <div class="meta-item">
          <span class="meta-icon">📍</span>
          <div>
            <strong>Location Segreta / Bassa Padana</strong>
            <small>Strictly "In Odor di Toscana" 🍷</small>
          </div>
        </div>
      </div>

      <!-- COUNTDOWN -->
      <div class="countdown-wrapper">
        <div class="countdown-box">
          <span id="days" class="countdown-val">--</span>
          <span class="countdown-lbl">Giorni</span>
        </div>
        <div class="countdown-box">
          <span id="hours" class="countdown-val">--</span>
          <span class="countdown-lbl">Ore</span>
        </div>
        <div class="countdown-box">
          <span id="minutes" class="countdown-val">--</span>
          <span class="countdown-lbl">Minuti</span>
        </div>
        <div class="countdown-box">
          <span id="seconds" class="countdown-val">--</span>
          <span class="countdown-lbl">Secondi</span>
        </div>
      </div>

      <div class="hero-cta">
        <a href="#menu" class="btn btn-primary">Scopri il Menu Esclusivo 🍽️</a>
        <a href={publicFormUrl} target="_blank" class="btn btn-secondary">Conferma Presenza (RSVP) ✍️</a>
      </div>
    </header>

    <!-- HIGHLIGHT SECTION: MENU CRUELTY-FREE -->
    <section id="menu" class="section">
      <div class="section-header">
        <span class="tag-green">🌱 ESCLUSIVA GASTRONOMICA CRUELTY-FREE & IN ODOR DI TOSCANA</span>
        <h2>Il Menu Ufficiale: Tra Veganiga e Nebbia Ferrarese</h2>
        <p class="section-desc">
          Un banchetto d'alta scuola a impatto karmico zero. Nessun animale è stato guardato con disappunto. Certificato <em>"Kate-Approved"</em> con abbondanti sentori toscani.
        </p>
      </div>

      <!-- SHOWCASE 1: ARIA DI BOSCO FERRARESE -->
      <div class="dish-showcase" style="border-color: rgba(245, 158, 11, 0.3); margin-bottom: 2.5rem;">
        <div class="dish-img-card">
          <img src={`${baseUrl}/images/aria_bosco_polenta_trasparente.png`} alt="Aria di Bosco della Bassa Ferrarese" class="dish-img" />
          <div class="dish-badge" style="color: var(--accent-gold); border-color: rgba(245, 158, 11, 0.4);">Antipasto Concettuale Etereo</div>
        </div>

        <div class="dish-details">
          <h3 class="dish-title">Aria di Bosco della Bassa Ferrarese emulsionata su Polenta Trasparente</h3>
          <p class="dish-story">
            Nebbia mattutina raccolta con retini di seta nelle pinete secolari di Mesola e del Lido degli Estensi. Emulsionata a ultrasuoni e delicatamente adagiata su un lingotto gelatinoso di polenta invisibile a zero calorie e impatto karmico negativo.
          </p>

          <div class="ingredients-list">
            <h4>🌲 Componenti Essenziali:</h4>
            <ul>
              <li>🌫️ <strong>Brezza Umida delle Valli di Comacchio:</strong> Catturata prima dell'alba.</li>
              <li>🌽 <strong>Polenta di Mais Trasparente Quantistica:</strong> Leggera come un'idea.</li>
              <li>🌱 <strong>Ago di Pino Singolo & Gocce di Rugiada:</strong> Per un'esperienza olfattiva totalizzante.</li>
            </ul>
          </div>
        </div>
      </div>

      <!-- SHOWCASE 2: LA VEGANIGA -->
      <div class="dish-showcase">
        <div class="dish-img-card">
          <img src={`${baseUrl}/images/bigoli_con_veganiga.png`} alt="Bigoli con la Veganiga" class="dish-img" />
          <div class="dish-badge">Piatto d'Onore D.O.P. Fittizio</div>
        </div>

        <div class="dish-details">
          <h3 class="dish-title">Bigoli al Torchio con la Vera Veganiga di Lugano <br/><span style="font-size: 1.1rem; color: #f59e0b;">(Strictly "In Odor di Toscana" 🍷)</span></h3>
          <p class="dish-story">
            La leggendaria salsiccia vegetale verde smeraldo del Ceresio, insaccata a mano senza stress emotivo per i broccoli, mantecata con una lacrima di Olio Extravergine delle Colline del Chianti. Perché, come ricorda sempre Kate: <em>"If it's not Tuscan, it's not worth eating!"</em> 🇬🇧
          </p>

          <div class="ingredients-list">
            <h4>🌿 Ingredienti Certificati:</h4>
            <ul>
              <li>🥦 <strong>Cimette di Broccolo & Cavolfiore Alpino:</strong> Rispettosamente stufate.</li>
              <li>🥒 <strong>Cetrioli Fermentati a Freddo:</strong> Crunchiness garantita.</li>
              <li>🫚 <strong>Zenzero Bio-Dinamico & Aria del Monte Brè:</strong> Sigillati in budello vegetale.</li>
              <li>🫒 <strong>Olio Toscano D.O.C.G.:</strong> Indispensabile per ottenere il visto di approvazione da Kate.</li>
            </ul>
          </div>

          <div class="quote-box">
            <em>"Sembra una luganiga, sa di orto sinergico, ma col Chianti va giù che è una bellezza!"</em>
            <div class="quote-author">— Ermete Bottazzi, Camionista & Gourmet 🚛</div>
          </div>
        </div>
      </div>

      <!-- SHOWCASE 3: TIRAMISU STRUDEL VEGANO -->
      <div class="dish-showcase" style="border-color: rgba(217, 119, 6, 0.4); margin-top: 2.5rem; margin-bottom: 3.5rem;">
        <div class="dish-img-card">
          <img src={`${baseUrl}/images/tiramisu_struzzo_vegano.png`} alt="Tiramisù all'Uovo Finto di Struzzo Vegano" class="dish-img" />
          <div class="dish-badge" style="color: #fbbf24; border-color: rgba(251, 191, 36, 0.4);">Dessert Molecolare Ingannevole</div>
        </div>

        <div class="dish-details">
          <h3 class="dish-title">Il Gran Tiramisù Imperiale all'Uovo di Struzzo Sinergico <br/><span style="font-size: 1.05rem; color: #fbbf24;">(100% Cruelty-Free • In Odor di Toscana 🍷)</span></h3>
          <p class="dish-story">
            Alla vista sembra un peccato di gola irresistibile: crema spumosa, biscotto soffice, polvere vellutata e un <strong>tuorlo dorato gigante</strong> che sembra zabaione colante purissimo. Ma non farti ingannare dagli occhi... la biochimica vegetale qui ha superato ogni limite morale.
          </p>

          <div class="ingredients-list">
            <h4>🍰 La Scheda Tecnica degli Ingredienti "Gourmet":</h4>
            <ul>
              <li>🥚 <strong>Il Finto Tuorlo di Struzzo:</strong> Sferificazione molecolare di <em>estratto puro di rapa gialla fermentata all'aglio dolce, salamoia concentrata di alga spirulina e lecitina di fagioli cannellini macerati</em>.</li>
              <li>🥛 <strong>La Spuma di "Mascarpone":</strong> Emulsione montata a caldo di <em>sego vegetale di cavolfiore cotto al vapore di cipolla borettana, latte di soia non filtrato e sciroppo di barbabietola acida</em>.</li>
              <li>🥖 <strong>I "Savoiardi" Ancestrali:</strong> Biscotti secchi di <em>crusca di lenticchie nere tostate, semi di lino viscidi e farina di cicoria</em>, inzuppati in un <em>decotto amarissimo di carciofo e tarassaco</em> (al posto del caffè).</li>
              <li>🍫 <strong>Lo "Spolvero di Cacao":</strong> Polvere purissima di <em>carbone vegetale attivo ottenuto da rami di melanzana bruciati all'aria di maremma</em>.</li>
            </ul>
          </div>

          <div class="quote-box">
            <em>"Bello da fotografare per Instagram... poi dai la prima cucchiaiata e capisci perché le galline si sono rifiutate di collaborare!"</em>
            <div class="quote-author">— Ermete Bottazzi, Critico di Bordo 🚛</div>
          </div>
        </div>
      </div>
      <!-- ALTRE PORTATE DEL MENU -->
      <div class="menu-grid">
        <div class="menu-card">
          <span class="menu-icon">🌫️</span>
          <h3>Antipasto Etereo</h3>
          <h4>Aria di Bosco Ferrarese</h4>
          <p>Polenta trasparente e vapore profumato delle pinete di Comacchio.</p>
        </div>
        <div class="menu-card featured">
          <span class="menu-icon">🍝</span>
          <h3>Primo d'Onore</h3>
          <h4>Bigoli con la Veganiga</h4>
          <p>Salsiccia verde di Lugano 'In Odor di Toscana' per accontentare Kate.</p>
        </div>
        <div class="menu-card">
          <span class="menu-icon">🥬</span>
          <h3>Secondo Filosofico</h3>
          <h4>Stracotto di Tofu di Maremma</h4>
          <p>Tofu cresciuto ascoltando Vivaldi, sfumato con finocchietto selvatico e rosmarino di Bolgheri.</p>
        </div>
        <div class="menu-card">
          <span class="menu-icon">🍨</span>
          <h3>Gran Dessert</h3>
          <h4>Tiramisù con Finto Uovo di Struzzo</h4>
          <p>Crema di mandorle sferificata con tuorlo di struzzo vegano al mango e savoiardi bio toscani.</p>
        </div>
      </div>
    </section>

    <!-- PROGRAMMA / COSA SI FA -->
    <section class="section alt-bg">
      <div class="section-header">
        <span class="tag-gold">⏰ IL PROGRAMMA</span>
        <h2>Cosa si fa il 29 Dicembre?</h2>
        <p class="section-desc">Un fitto calendario di celebrazioni per il mezzo secolo di Riccardo.</p>
      </div>

      <div class="timeline">
        <div class="timeline-item">
          <div class="time">18:00</div>
          <div class="timeline-content">
            <h3>Inizio Aperitivo 🍸</h3>
            <p>Accoglienza ospiti, inalazione dell'Aria di Bosco Ferrarese, bollicine e prime battute sul karma vegetale.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="time">19:45</div>
          <div class="timeline-content">
            <h3>La Grande Cena 🍝</h3>
            <p>Servizio solenne dei Bigoli al Torchio con la Veganiga di Lugano (In Odor di Toscana), Stracotto di Tofu e Chianti a fiumi.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="time">21:45</div>
          <div class="timeline-content">
            <h3>DopoCena, Tiramisù allo Struzzo & Rock '80 🎸</h3>
            <p>Taglio del Tiramisù con uova finte di struzzo, brindisi toscani e colonna sonora epica con spade laser e draghi.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="time">24:00</div>
          <div class="timeline-content">
            <h3>Tutti Fuori Dalle Balle! 🚛💨</h3>
            <p>Chiusura cancelli, abbracci calorosi e rientro alle proprie dimore prima che scatti il coprifuoco.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- RSVP SECTION -->
    <section id="rsvp" class="section">
      <div class="rsvp-card">
        <h2>Sei dei Nostri? ✍️</h2>
        <p>Compila il modulo ufficiale per farci sapere se verrai, quanti sarete e se il tuo apparato digerente è pronto alla sfida gastronomica del secolo.</p>
        
        <div style="margin-top: 2rem;">
          <a href={publicFormUrl} target="_blank" class="btn btn-primary btn-block" style="display: inline-block; text-align: center; font-size: 1.15rem; padding: 1.1rem 2rem;">
            Compila il Google Form Ufficiale (RSVP) 📝✨
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <p>50° Compleanno Palladiano • 29 Dicembre 2026 • In Odor di Toscana 🍷</p>
      <small>Confezionato con ❤️ e Astro da Ermete Bottazzi 🚛 • <a href="https://github.com/palladius/compleanno-palladiano-2026" target="_blank">GitHub Repo</a></small>
    </footer>
  </main>

  <script>
    // Live Countdown
    const targetDate = new Date("2026-12-29T18:00:00+01:00").getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance < 0) {
        document.getElementById("days").innerText = "0";
        document.getElementById("hours").innerText = "0";
        document.getElementById("minutes").innerText = "0";
        document.getElementById("seconds").innerText = "0";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      document.getElementById("days").innerText = days;
      document.getElementById("hours").innerText = hours;
      document.getElementById("minutes").innerText = minutes;
      document.getElementById("seconds").innerText = seconds;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .hero {
    text-align: center;
    padding: 4rem 1rem 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-gold);
    border: 1px solid var(--accent-gold);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }

  .gold-text {
    color: var(--accent-gold);
    background: linear-gradient(135deg, #fbbf24, #d97706);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .event-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--bg-card);
    padding: 0.8rem 1.4rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
  }

  .meta-icon {
    font-size: 1.8rem;
  }

  .meta-item strong {
    display: block;
    font-size: 1rem;
  }

  .meta-item small {
    color: var(--text-muted);
  }

  /* COUNTDOWN */
  .countdown-wrapper {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0 2.5rem;
    flex-wrap: wrap;
  }

  .countdown-box {
    background: var(--bg-card);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 1rem 1.5rem;
    border-radius: 16px;
    min-width: 90px;
    text-align: center;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .countdown-val {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--accent-gold);
    display: block;
    line-height: 1;
    font-family: 'Playfair Display', serif;
  }

  .countdown-lbl {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-top: 0.4rem;
    display: block;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.9rem 1.8rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-size: 1rem;
    border: none;
  }

  .btn-primary {
    background: var(--accent-gold);
    color: #0f172a;
  }

  .btn-primary:hover {
    background: #d97706;
    transform: translateY(-2px);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  /* SECTIONS */
  .section {
    padding: 5rem 0;
  }

  .section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3.5rem;
  }

  .tag-green {
    color: var(--accent-green);
    font-weight: 700;
    letter-spacing: 1.5px;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tag-gold {
    color: var(--accent-gold);
    font-weight: 700;
    letter-spacing: 1.5px;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2.4rem;
    margin-bottom: 1rem;
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  /* DISH SHOWCASE */
  .dish-showcase {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3rem;
    background: var(--bg-card);
    border-radius: 24px;
    padding: 2.5rem;
    border: 1px solid rgba(16, 185, 129, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    margin-bottom: 3rem;
    align-items: center;
  }

  @media (max-width: 850px) {
    .dish-showcase {
      grid-template-columns: 1fr;
    }
  }

  .dish-img-card {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
  }

  .dish-img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 16px;
    transition: transform 0.3s ease;
  }

  .dish-img:hover {
    transform: scale(1.03);
  }

  .dish-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    color: var(--accent-green);
    font-weight: 700;
    font-size: 0.8rem;
    padding: 0.4rem 0.8rem;
    border-radius: 8px;
    border: 1px solid rgba(16, 185, 129, 0.4);
  }

  .dish-title {
    font-size: 1.85rem;
    color: var(--accent-gold);
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .dish-story {
    font-size: 1.05rem;
    color: var(--text-light);
    margin-bottom: 1.5rem;
  }

  .ingredients-list h4 {
    color: var(--accent-green);
    margin-bottom: 0.8rem;
    font-size: 1rem;
  }

  .ingredients-list ul {
    list-style: none;
    margin-bottom: 1.5rem;
  }

  .ingredients-list li {
    padding: 0.3rem 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .quote-box {
    background: rgba(0, 0, 0, 0.25);
    border-left: 3px solid var(--accent-gold);
    padding: 1rem;
    border-radius: 0 12px 12px 0;
    font-style: italic;
  }

  .quote-author {
    font-style: normal;
    font-size: 0.85rem;
    color: var(--accent-gold);
    margin-top: 0.5rem;
    font-weight: 600;
  }

  /* MENU GRID */
  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }

  .menu-card {
    background: var(--bg-card);
    padding: 1.8rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: center;
  }

  .menu-card.featured {
    border-color: rgba(245, 158, 11, 0.4);
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.05) 0%, var(--bg-card) 100%);
  }

  .menu-icon {
    font-size: 2.2rem;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .menu-card h3 {
    font-size: 1.2rem;
    color: var(--accent-gold);
    margin-bottom: 0.3rem;
  }

  .menu-card h4 {
    font-size: 1.05rem;
    margin-bottom: 0.8rem;
  }

  .menu-card p {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  /* TIMELINE */
  .timeline {
    max-width: 650px;
    margin: 0 auto;
    position: relative;
    border-left: 2px solid rgba(245, 158, 11, 0.3);
    padding-left: 2rem;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -2.45rem;
    top: 0.2rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent-gold);
    box-shadow: 0 0 10px var(--accent-gold);
  }

  .timeline-item .time {
    font-weight: 800;
    color: var(--accent-gold);
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }

  .timeline-content h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .timeline-content p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  /* RSVP CARD */
  .rsvp-card {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 24px;
    padding: 3rem 2rem;
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
