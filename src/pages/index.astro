---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";

const dishes = [
  {
    id: "aria-bosco",
    course: "Antipasto Concettuale",
    badgeColor: "#f59e0b",
    title: "Aria di Bosco Ferrarese",
    subtitle: "Emulsionata su Polenta Trasparente",
    tagline: "Nebbia di Comacchio e rugiada mattutina a impatto karmico negativo.",
    image: `${baseUrl}/images/aria_bosco_polenta_trasparente.png`,
    video: `${baseUrl}/videos/aria_bosco_dry_ice.mp4`,
    hasVideo: true,
    story: "Nebbia mattutina raccolta con retini di seta nelle pinete secolari di Mesola e del Lido degli Estensi. Emulsionata a ultrasuoni e delicatamente adagiata su un lingotto gelatinoso di polenta invisibile a zero calorie e impatto karmico negativo. Mica pizze e fichi!",
    ingredients: [
      "🌫️ Brezza Umida delle Valli di Comacchio catturata prima dell'alba.",
      "🌽 Polenta di Mais Trasparente Quantistica a zero calorie.",
      "🌲 Singolo Ago di Pino & Gocce di Rugiada aromatica."
    ],
    quote: "Bello, leggero... talmente etereo che dopo tre portate hai più fame di prima!",
    author: "Ermete Bottazzi, Camionista & Critico 🚛"
  },
  {
    id: "pizze-fichi",
    course: "Antipasto d'Autore",
    badgeColor: "#f87171",
    title: "Pizze e Fichi di Bottura",
    subtitle: "Mica pizze e fichi di Cetto La Qualunque!",
    tagline: "Mini margherite fumanti e fichi freschi in scrigno bifasico.",
    image: `${baseUrl}/images/pizze_e_fichi_vegetariano.png`,
    hasVideo: false,
    story: "Omaggio concettuale irriverente all'alta cucina emiliana per gli ospiti vegetariani non-vegani. Uno scrigno diviso rigidamente a metà: da un lato la fragranza del fiordilatte filante, dall'altro la dolcezza ancestrale del fico fresco. Zero contaminazione!",
    ingredients: [
      "🍕 Mini Pizzette Margherita calde con mozzarella fiordilatte e basilico.",
      "🍇 Fichi Freschi di Raccolta neri e verdi tagliati a metà con nettare naturale.",
      "🙅‍♂️ Separatore Molecolare: i fichi non toccano la pizza prima del morso."
    ],
    quote: "Dicevano 'Mica pizze e fichi!'... e infatti queste sono le Pizze e Fichi di Bottura, mica roba da quattro soldi!",
    author: "Ermete Bottazzi, Filosofo della Strada 🚛"
  },
  {
    id: "veganiga",
    course: "Primo Piatto D.O.P.",
    badgeColor: "#10b981",
    title: "Bigoli con la Veganiga",
    subtitle: "La Vera Salsiccia Verde di Lugano",
    tagline: "100% bio-ingegneria ticinese insaccata a mano.",
    image: `${baseUrl}/images/bigoli_con_veganiga.png`,
    hasVideo: false,
    story: "La leggendaria salsiccia vegetale verde smeraldo del Ceresio, insaccata rigorosamente a mano senza alcuno stress emotivo per i broccoli alpini. Un capolavoro ticinese di bio-ingegneria che sfida la norcineria tradizionale.",
    ingredients: [
      "🥦 Cimette di Broccolo & Cavolfiore Alpino stufate al vapore.",
      "🥒 Cetrioli Fermentati a Freddo per una croccantezza rinfrescante.",
      "🫚 Zenzero Bio-Dinamico & Aria del Monte Brè in budello vegetale."
    ],
    quote: "Sembra una luganiga, sa di orto sinergico, ma se ci bevi sopra sembra quasi un miracolo!",
    author: "Ermete Bottazzi, Camionista & Gourmet 🚛"
  },
  {
    id: "tofu-maremma",
    course: "Secondo • In Odor di Toscana 🍷",
    badgeColor: "#10b981",
    title: "Stracotto di Tofu di Maremma",
    subtitle: "Coltivato vicino a Mucche Ignare 🐮",
    tagline: "Cubi di tofu sbocciati nei campi toscani stufati al Chianti.",
    image: `${baseUrl}/images/tofu_maremma_mucche_ignare.png`,
    hasVideo: false,
    story: "Coltivato direttamente sui cespugli biologici della Maremma toscana, dove i cubi di tofu bianco fioriscono spontaneamente sotto il sole caldo mentre le mucche chianine pascolano pacifiche e completamente ignare sullo sfondo. Coccolato con musica classica e stufato in riduzione di Chianti e rosmarino di Bolgheri.",
    ingredients: [
      "🌱 Piante di Tofu da Arbusto Spontaneo raccolte a perfetta maturazione cubica.",
      "🐮 Mucche 100% Ignare che pascolano indisturbate sullo sfondo.",
      "🌿 Aromi di Bolgheri & Chianti: Strictly In Odor di Toscana."
    ],
    quote: "Se le mucche sapessero cosa stiamo mangiando, si farebbero una risata anche loro!",
    author: "Ermete Bottazzi, Gourmet di Bordo 🚛"
  },
  {
    id: "tiramisu",
    course: "Dessert Molecolare",
    badgeColor: "#fbbf24",
    title: "Tiramisù allo Struzzo Vegano",
    subtitle: "Con Finto Tuorlo Gigante Sinergico",
    tagline: "Sembra irresistibile finché non leggi la scheda tecnica...",
    image: `${baseUrl}/images/tiramisu_struzzo_vegano.png`,
    hasVideo: false,
    story: "Alla vista sembra un peccato di gola irresistibile: crema spumosa, biscotto soffice, polvere vellutata e un tuorlo dorato gigante che sembra zabaione colante purissimo. Ma non farti ingannare dagli occhi... la biochimica vegetale qui ha superato ogni limite morale.",
    ingredients: [
      "🥚 Finto Tuorlo di Struzzo: sferificazione di rapa gialla fermentata all'aglio dolce, spirulina e cannellini.",
      "🥛 Spuma di Mascarpone: emulsione di sego di cavolfiore al vapore di cipolla e latte di soia grezzo.",
      "🥖 Savoiardi Ancestrali: crusca di lenticchie nere e semi di lino inzuppati in decotto di carciofo e tarassaco.",
      "🍫 Spolvero di Cacao: carbone vegetale attivo da rami di melanzana bruciati."
    ],
    quote: "Bello da fotografare per Instagram... poi dai la prima cucchiaiata e capisci perché le galline si sono rifiutate di collaborare!",
    author: "Ermete Bottazzi, Critico Gastronomico 🚛"
  }
];
---

<Layout title="50 Sfumature di Giallo | Il 50° Compleanno Palladiano 💛">
  <main class="container">
    <!-- HERO SECTION -->
    <header class="hero">
      <div class="birthday-avatar-wrapper">
        <div class="badge-super">💛 50 SFUMATURE DI GIALLO 💛</div>
        <div class="avatar-container">
          <img 
            src={`${baseUrl}/images/riccardo_50_portrait.png`} 
            alt="Riccardo 50 Anni - 50 Sfumature di Giallo" 
            class="birthday-avatar" 
          />
          <div class="avatar-crown-badge">👑 50 & Fabulous</div>
        </div>
        <div class="badge">SAVE THE DATE • MARTEDÌ 29 DICEMBRE 2026</div>
      </div>
      <h1 class="hero-title">50 Sfumature <br/><span class="gold-text">di Giallo</span></h1>
      <p class="hero-subtitle">
        <strong>Il Cinquantesimo Compleanno Palladiano:</strong> mezzo secolo di avventure, codice, bicicletta, cappelletti e... scelte gastronomiche d'avanguardia.
      </p>
      
      <div class="event-meta">
        <div class="meta-item">
          <span class="meta-icon">📅</span>
          <div>
            <strong>Martedì 29 Dicembre 2026</strong>
            <small>Dalle ore 18:00 a mezzanotte</small>
          </div>
        </div>
        <div class="meta-item">
          <span class="meta-icon">📍</span>
          <div>
            <strong>Location Segreta / Bassa Padana</strong>
            <small>Strictly "In Odor di Toscana" 🍷</small>
          </div>
        </div>
      </div>

      <!-- COUNTDOWN -->
      <div class="countdown-wrapper">
        <div class="countdown-box">
          <span id="days" class="countdown-val">--</span>
          <span class="countdown-lbl">Giorni</span>
        </div>
        <div class="countdown-box">
          <span id="hours" class="countdown-val">--</span>
          <span class="countdown-lbl">Ore</span>
        </div>
        <div class="countdown-box">
          <span id="minutes" class="countdown-val">--</span>
          <span class="countdown-lbl">Minuti</span>
        </div>
        <div class="countdown-box">
          <span id="seconds" class="countdown-val">--</span>
          <span class="countdown-lbl">Secondi</span>
        </div>
      </div>

      <div class="hero-cta">
        <a href="#menu" class="btn btn-primary">Scopri il Menu Esclusivo 🍽️</a>
        <a href={publicFormUrl} target="_blank" class="btn btn-secondary">Conferma Presenza (RSVP) ✍️</a>
      </div>
    </header>

    <!-- COMPACT MENU SECTION (GRID 2x3) -->
    <section id="menu" class="section">
      <div class="section-header">
        <span class="tag-green">🌱 IL BANQUETTO D'AVANGUARDIA CRUELTY-FREE</span>
        <h2>Il Menu Ufficiale: Tra Veganiga e Nebbia Ferrarese</h2>
        <p class="section-desc">
          Clicca su una portata per svelare ingredienti segreti, recensioni e retroscena culinari.
        </p>
      </div>

      <!-- GRID OF CARDS -->
      <div class="dishes-grid">
        {dishes.map((dish) => (
          <div 
            class={`dish-card ${dish.hasVideo ? 'hover-video-card' : ''}`}
            data-dish-id={dish.id}
          >
            <div class="card-img-wrapper">
              <img src={dish.image} alt={dish.title} class="card-img" />
              {dish.hasVideo && (
                <video 
                  src={dish.video} 
                  loop 
                  muted 
                  playsinline 
                  class="card-video"
                ></video>
              )}
              <span class="card-badge" style={`color: ${dish.badgeColor}; border-color: ${dish.badgeColor};`}>
                {dish.course}
              </span>
              {dish.hasVideo && (
                <span class="video-indicator">🎬 Video Veo (Hover)</span>
              )}
            </div>

            <div class="card-content">
              <h3 class="card-title">{dish.title}</h3>
              <h4 class="card-subtitle">{dish.subtitle}</h4>
              <p class="card-tagline">{dish.tagline}</p>
              
              <button class="btn-card-expand">
                Vedi scheda & ingredienti 🔍
              </button>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PROGRAMMA / COSA SI FA -->
    <section class="section alt-bg">
      <div class="section-header">
        <span class="tag-gold">⏰ IL PROGRAMMA</span>
        <h2>Cosa si fa il 29 Dicembre?</h2>
        <p class="section-desc">Un fitto calendario di celebrazioni per il mezzo secolo di Riccardo.</p>
      </div>

      <div class="timeline">
        <div class="timeline-item">
          <div class="time">18:00</div>
          <div class="timeline-content">
            <h3>Inizio Aperitivo 🍸</h3>
            <p>Accoglienza ospiti, inalazione dell'Aria di Bosco Ferrarese, bollicine e prime battute sul karma vegetale.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="time">19:45</div>
          <div class="timeline-content">
            <h3>La Grande Cena 🍝</h3>
            <p>Servizio solenne dei Bigoli con la Veganiga di Lugano, Stracotto di Tofu di Maremma e Chianti a fiumi.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="time">21:45</div>
          <div class="timeline-content">
            <h3>DopoCena, Tiramisù allo Struzzo & Rock '80 🎸</h3>
            <p>Taglio del Tiramisù con uova finte di struzzo, brindisi toscani e colonna sonora epica con spade laser e draghi.</p>
          </div>
        </div>
        <div class="timeline-item">
          <div class="time">24:00</div>
          <div class="timeline-content">
            <h3>Tutti Fuori Dalle Balle! 🚛💨</h3>
            <p>Chiusura cancelli, abbracci calorosi e rientro alle proprie dimore prima che scatti il coprifuoco.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- RSVP SECTION -->
    <section id="rsvp" class="section">
      <div class="rsvp-card">
        <h2>Sei dei Nostri? ✍️</h2>
        <p>Compila il modulo ufficiale per farci sapere se verrai, quanti sarete e se il tuo apparato digerente è pronto alla sfida gastronomica del secolo.</p>
        
        <div style="margin-top: 2rem;">
          <a href={publicFormUrl} target="_blank" class="btn btn-primary btn-block" style="display: inline-block; text-align: center; font-size: 1.15rem; padding: 1.1rem 2rem;">
            Compila il Google Form Ufficiale (RSVP) 📝✨
          </a>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
      <p>50 Sfumature di Giallo • 29 Dicembre 2026 • In Odor di Toscana 🍷</p>
      <small>Confezionato con ❤️ e Astro da Ermete Bottazzi 🚛 • <a href="https://github.com/palladius/compleanno-palladiano-2026" target="_blank">GitHub Repo</a></small>
    </footer>

    <!-- DISH DETAIL MODAL (LIGHTBOX) -->
    <div id="dishModal" class="dish-modal" aria-hidden="true">
      <div class="dish-modal-backdrop" id="modalBackdrop"></div>
      <div class="dish-modal-container">
        <button class="dish-modal-close" id="modalClose" aria-label="Chiudi">&times;</button>
        
        <div class="modal-media-wrapper" id="modalMediaWrapper">
          <img id="modalImg" src="" alt="" class="modal-media" />
          <video id="modalVid" src="" controls autoplay loop playsinline class="modal-media" style="display: none;"></video>
        </div>

        <div class="modal-body">
          <span class="modal-badge" id="modalBadge"></span>
          <h2 class="modal-title" id="modalTitle"></h2>
          <h4 class="modal-subtitle" id="modalSubtitle"></h4>
          <p class="modal-story" id="modalStory"></p>

          <div class="modal-ingredients">
            <h4>🌿 Scheda Tecnica & Ingredienti:</h4>
            <ul id="modalIngredientsList"></ul>
          </div>

          <div class="modal-quote" id="modalQuoteWrapper">
            <em id="modalQuoteText"></em>
            <div class="modal-quote-author" id="modalQuoteAuthor"></div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ dishes }}>
    // Live Countdown
    const targetDate = new Date("2026-12-29T18:00:00+01:00").getTime();

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = targetDate - now;

      if (distance < 0) {
        document.getElementById("days").innerText = "0";
        document.getElementById("hours").innerText = "0";
        document.getElementById("minutes").innerText = "0";
        document.getElementById("seconds").innerText = "0";
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      document.getElementById("days").innerText = days;
      document.getElementById("hours").innerText = hours;
      document.getElementById("minutes").innerText = minutes;
      document.getElementById("seconds").innerText = seconds;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);

    // Hover video preview for cards
    document.querySelectorAll('.hover-video-card').forEach(card => {
      const vid = card.querySelector('video');
      if (vid) {
        card.addEventListener('mouseenter', () => { vid.play().catch(() => {}); });
        card.addEventListener('mouseleave', () => { vid.pause(); vid.currentTime = 0; });
      }
    });

    // Modal Details Logic
    const modal = document.getElementById('dishModal');
    const modalBackdrop = document.getElementById('modalBackdrop');
    const modalClose = document.getElementById('modalClose');
    const modalImg = document.getElementById('modalImg');
    const modalVid = document.getElementById('modalVid');
    const modalBadge = document.getElementById('modalBadge');
    const modalTitle = document.getElementById('modalTitle');
    const modalSubtitle = document.getElementById('modalSubtitle');
    const modalStory = document.getElementById('modalStory');
    const modalIngredientsList = document.getElementById('modalIngredientsList');
    const modalQuoteText = document.getElementById('modalQuoteText');
    const modalQuoteAuthor = document.getElementById('modalQuoteAuthor');

    function openDishModal(dishId) {
      const dish = dishes.find(d => d.id === dishId);
      if (!dish || !modal) return;

      if (dish.hasVideo) {
        modalImg.style.display = 'none';
        modalVid.style.display = 'block';
        modalVid.src = dish.video;
        modalVid.play().catch(() => {});
      } else {
        modalVid.style.display = 'none';
        modalVid.pause();
        modalVid.src = '';
        modalImg.style.display = 'block';
        modalImg.src = dish.image;
        modalImg.alt = dish.title;
      }

      modalBadge.innerText = dish.course;
      modalBadge.style.color = dish.badgeColor;
      modalBadge.style.borderColor = dish.badgeColor;

      modalTitle.innerText = dish.title;
      modalSubtitle.innerText = dish.subtitle;
      modalStory.innerText = dish.story;

      modalIngredientsList.innerHTML = '';
      dish.ingredients.forEach(ing => {
        const li = document.createElement('li');
        li.innerText = ing;
        modalIngredientsList.appendChild(li);
      });

      modalQuoteText.innerText = `"${dish.quote}"`;
      modalQuoteAuthor.innerText = `— ${dish.author}`;

      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeDishModal() {
      if (!modal) return;
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      if (modalVid) {
        modalVid.pause();
        modalVid.src = '';
      }
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.dish-card').forEach(card => {
      card.addEventListener('click', () => {
        const dishId = card.getAttribute('data-dish-id');
        if (dishId) openDishModal(dishId);
      });
    });

    if (modalClose) modalClose.addEventListener('click', closeDishModal);
    if (modalBackdrop) modalBackdrop.addEventListener('click', closeDishModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeDishModal();
      }
    });
  </script>
</Layout>

<style>
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .hero {
    text-align: center;
    padding: 4rem 1rem 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* HERO BIRTHDAY AVATAR */
  .birthday-avatar-wrapper {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge-super {
    display: inline-block;
    padding: 0.5rem 1.5rem;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    border-radius: 9999px;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    box-shadow: 0 0 25px rgba(245, 158, 11, 0.5);
    text-transform: uppercase;
  }

  .avatar-container {
    position: relative;
    width: 290px;
    height: 290px;
    margin-bottom: 1.8rem;
  }

  .birthday-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    border: 4px solid var(--accent-gold);
    box-shadow: 0 0 40px rgba(245, 158, 11, 0.55);
    display: block;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .birthday-avatar:hover {
    transform: scale(1.04);
    box-shadow: 0 0 50px rgba(245, 158, 11, 0.8);
  }

  .avatar-crown-badge {
    position: absolute;
    bottom: -10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid var(--accent-gold);
    color: var(--accent-gold);
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 800;
    white-space: nowrap;
    box-shadow: 0 4px 15px rgba(0,0,0,0.6);
  }

  .badge {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    background: rgba(245, 158, 11, 0.15);
    color: var(--accent-gold);
    border: 1px solid var(--accent-gold);
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .hero-title {
    font-size: 3.5rem;
    line-height: 1.15;
    margin-bottom: 1.2rem;
  }

  .gold-text {
    color: var(--accent-gold);
    background: linear-gradient(135deg, #fbbf24, #d97706);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .event-meta {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: var(--bg-card);
    padding: 0.8rem 1.4rem;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    text-align: left;
  }

  .meta-icon {
    font-size: 1.8rem;
  }

  .meta-item strong {
    display: block;
    font-size: 1rem;
  }

  .meta-item small {
    color: var(--text-muted);
  }

  /* COUNTDOWN */
  .countdown-wrapper {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0 2.5rem;
    flex-wrap: wrap;
  }

  .countdown-box {
    background: var(--bg-card);
    border: 1px solid rgba(245, 158, 11, 0.3);
    padding: 1rem 1.5rem;
    border-radius: 16px;
    min-width: 90px;
    text-align: center;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
  }

  .countdown-val {
    font-size: 2.2rem;
    font-weight: 800;
    color: var(--accent-gold);
    display: block;
    line-height: 1;
    font-family: 'Playfair Display', serif;
  }

  .countdown-lbl {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--text-muted);
    margin-top: 0.4rem;
    display: block;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    padding: 0.9rem 1.8rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-size: 1rem;
    border: none;
