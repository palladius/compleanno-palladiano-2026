---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";

const accommodations = [
  {
    type: "B&B / Agriturismo",
    name: "Agriturismo Il Giardino dei Fichi",
    dist: "A 5 minuti dalla location",
    dist_en: "5 mins from venue",
    badge: "Consigliato • Relax",
    badge_en: "Recommended • Peaceful",
    desc_it: "Immerso nel verde della pianura, stanze rustiche e colazione con torte fatte in casa. Ideale per chi vuole relax totale prima e dopo la festa.",
    desc_en: "Immersed in countryside greenery, rustic suites and homemade breakfast pies. Ideal for total tranquility before and after the party.",
    price: "€€ (70-95€ / notte)",
    link: "https://www.booking.com/"
  },
  {
    type: "Hotel 4 Stelle",
    name: "Hotel Corte Estense & Spa",
    dist: "A 10 minuti di auto",
    dist_en: "10 mins drive",
    badge: "Comfort & Spa",
    badge_en: "Comfort & Spa",
    desc_it: "Hotel moderno con parcheggio custodito, docce extralarge per togliersi la polvere del viaggio alle 15:00 e colazione continentale abbondante.",
    desc_en: "Modern hotel with secure parking, extra-large showers to freshen up at 15:00, and rich continental buffet breakfast.",
    price: "€€€ (100-130€ / notte)",
    link: "https://www.booking.com/"
  },
  {
    type: "Locanda Storica",
    name: "Locanda del Camionista Filosofo 🚛",
    dist: "A 2 passi dalla festa",
    dist_en: "Walking distance",
    badge: "Ermete Bottazzi Approved",
    badge_en: "Ermete Bottazzi Approved",
    desc_it: "Poche camere essenziali, accoglienza calorosa romagnola, nessun fronzolo e materassi a molle rigide per dormire come sassi dopo il Tiramisù.",
    desc_en: "Essential rooms, warm Romagna hospitality, zero fluff, and firm mattresses to sleep like a rock after the Vegan Ostrich Tiramisù.",
    price: "€ (50-70€ / notte)",
    link: "https://www.booking.com/"
  }
];

const faqs = [
  {
    q_it: "A che ora posso arrivare per fare il check-in e una doccia?",
    q_en: "What time can I arrive to check in and freshen up?",
    a_it: "Dalle 15:00! Abbiamo previsto una fascia oraria pomeridiana relax per permettere a chi viaggia da lontano (Svizzera, Milano, Roma o altrove) di posare lo zaino, farsi una doccia calda e prepararsi senza fretta prima dell'inizio dell'aperitivo alle 18:00.",
    a_en: "From 15:00! We scheduled an early afternoon window specifically so guests traveling from far away (Zurich, Milan, Rome, etc.) can drop their luggage, take a hot shower, and get dressed without rush before the 18:00 welcome drinks."
  },
  {
    q_it: "C'è parcheggio disponibile per auto e furgoni?",
    q_en: "Is there parking available for cars and vans?",
    a_it: "Sì, ampio parcheggio gratuito in loco per tutte le vetture, biciclette da corsa Colnago e persino per il camion di Ermete Bottazzi 🚛.",
    a_en: "Yes, ample free parking on-site for all cars, Colnago road bikes, and even Ermete Bottazzi's heavy truck 🚛."
  },
  {
    q_it: "Qual è il dress code consigliato?",
    q_en: "What is the recommended dress code?",
    a_it: "Smart casual / festoso! Un tocco di GIALLO (cravatta, sciarpa, calzini, abito o spilla) è caldamente apprezzato ma non obbligatorio. L'importante è essere comodi per ballare il rock anni '80.",
    a_en: "Smart casual / festive! A subtle touch of YELLOW (tie, scarf, socks, dress, or pin) is warmly appreciated. Most importantly, dress comfortably to dance to 80s rock."
  },
  {
    q_it: "Come posso segnalare allergie o intolleranze?",
    q_en: "How do I communicate allergies or dietary requirements?",
    a_it: "Nel modulo RSVP trovi una sezione apposita per le note alimentari. Tutto il menu principale è cruelty-free e a base vegetale d'avanguardia!",
    a_en: "Use the dedicated field in the official RSVP Form. The entire main banquet is already avant-garde cruelty-free and plant-based!"
  }
];
---

<Layout title="Dormire & Logistica | 50° Compleanno Palladiano 🛏️" currentPage="dormire">
  <main class="container">
    <header class="section-header">
      <span class="tag-blue">🛏️ OSPITALITÀ & LOGISTICA DI VIAGGIO</span>
      <h1 class="page-title">
        <span lang-it>Dove Dormire & Come Arrivare</span>
        <span lang-en>Where to Stay & How to Get Here</span>
      </h1>
      <p class="section-desc">
        <span lang-it>Tutte le informazioni per chi viaggia da lontano: orari check-in, strutture consigliate nei dintorni e consigli pratici.</span>
        <span lang-en>All the practical details for guests traveling from afar: check-in timings, curated nearby lodging, and logistics.</span>
      </p>
    </header>

    <!-- EARLY ARRIVAL HIGHLIGHT BOX -->
    <div class="early-arrival-banner">
      <div class="banner-badge">
        <span class="time">15:00</span>
        <span class="badge-tag" lang-it>[OPZIONALE]</span>
        <span class="badge-tag" lang-en>[OPTIONAL]</span>
      </div>
      <div class="banner-body">
        <h3 lang-it>Arrivi da lontano? Molla lo zaino e fai una doccia! 🎒🚿</h3>
        <h3 lang-en>Traveling from afar? Drop your backpack & freshen up! 🎒🚿</h3>
        <p lang-it>
          Se arrivi in aereo, treno o hai macinato centinaia di chilometri in autostrada, ti consigliamo di arrivare verso le <strong>15:00</strong>. Potrai prendere possesso della camera, fare una doccia calda rinfrescante, rilassarti e scendere riposato e profumato per l'inizio dell'aperitivo alle <strong>18:00</strong>.
        </p>
        <p lang-en>
          If you are flying, taking the train, or driving hours on the highway, we recommend arriving around <strong>15:00</strong>. You can check into your room, take a refreshing hot shower, unwind, and stroll down rested and glowing for the <strong>18:00</strong> cocktail kickoff!
        </p>
      </div>
    </div>

    <!-- ACCOMMODATION CARDS -->
    <section class="section">
      <div class="section-header">
        <span class="tag-gold">🏨 STRUTTURE CONSIGLIATE</span>
        <h2 lang-it>Alloggi nei Dintorni</h2>
        <h2 lang-en>Nearby Recommended Hotels & B&Bs</h2>
      </div>

      <div class="lodging-grid">
        {accommodations.map(acc => (
          <div class="lodging-card">
            <div class="card-top">
              <span class="lodging-type">{acc.type}</span>
              <span class="lodging-badge">
                <span lang-it>{acc.badge}</span>
                <span lang-en>{acc.badge_en}</span>
              </span>
            </div>
            <h3 class="lodging-name">{acc.name}</h3>
            <div class="lodging-dist">
              📍 <span lang-it>{acc.dist}</span><span lang-en>{acc.dist_en}</span> • <span class="price-tag">{acc.price}</span>
            </div>
            <p class="lodging-desc">
              <span lang-it>{acc.desc_it}</span>
              <span lang-en>{acc.desc_en}</span>
            </p>
            <div class="lodging-action">
              <a href={acc.link} target="_blank" class="btn btn-secondary btn-sm">
                <span lang-it>Cerca disponibilità 🔍</span>
                <span lang-en>Check availability 🔍</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- TRANSPORT & DIRECTIONS -->
    <section class="section alt-bg">
      <div class="section-header">
        <span class="tag-green">🚗 LOGISTICA & TRASPORTI</span>
        <h2 lang-it>Come Raggiungere la Festa</h2>
        <h2 lang-en>Getting to the Celebration</h2>
      </div>

      <div class="transport-grid">
        <div class="transport-box">
          <div class="transport-icon">🚗</div>
          <h4 lang-it>In Auto / Moto</h4>
          <h4 lang-en>By Car / Motorcycle</h4>
          <p lang-it>Autostrada A14 / A13 con uscita consigliata nei pressi della location. Ampio parcheggio gratuito all'ingresso.</p>
          <p lang-en>Highway A14 / A13 exit nearby. Generous free parking directly at the entrance.</p>
        </div>
        <div class="transport-box">
          <div class="transport-icon">🚄</div>
          <h4 lang-it>In Treno</h4>
          <h4 lang-en>By Train (Frecciarossa/Italo)</h4>
          <p lang-it>Stazione AV di Bologna Centrale o Ferrara. Da lì servizio taxi o navetta concordata per gli ospiti.</p>
          <p lang-en>High-speed stations Bologna Centrale or Ferrara, followed by a short taxi or shared ride.</p>
        </div>
        <div class="transport-box">
          <div class="transport-icon">✈️</div>
          <h4 lang-it>In Aereo</h4>
          <h4 lang-en>By Plane</h4>
          <p lang-it>Aeroporto Guglielmo Marconi di Bologna (BLQ) a circa 45 minuti dalla location dell'evento.</p>
          <p lang-en>Bologna Airport (BLQ), approximately 45 minutes from the venue.</p>
        </div>
      </div>
    </section>

    <!-- FAQS ACCORDION -->
    <section class="section">
      <div class="section-header">
        <span class="tag-gold">❓ DOMANDE FREQUENTI</span>
        <h2 lang-it>Domande & Risposte</h2>
        <h2 lang-en>Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        {faqs.map(faq => (
          <div class="faq-card">
            <h3 class="faq-q">
              <span lang-it>❓ {faq.q_it}</span>
              <span lang-en>❓ {faq.q_en}</span>
            </h3>
            <p class="faq-a">
              <span lang-it>{faq.a_it}</span>
              <span lang-en>{faq.a_en}</span>
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <div class="dormire-cta">
      <a href={publicFormUrl} target="_blank" class="btn btn-primary">
        <span lang-it>Conferma Presenza nel Form RSVP ✍️</span>
        <span lang-en>Confirm Attendance via RSVP ✍️</span>
      </a>
      <a href={`${baseUrl}/contatti`} class="btn btn-secondary">
        <span lang-it>Hai altre domande? Scrivici ✉️</span>
        <span lang-en>More questions? Contact Us ✉️</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .page-title {
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: 0.8rem;
    color: var(--text-light);
  }

  /* EARLY ARRIVAL BANNER */
  .early-arrival-banner {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.85));
    border: 2px solid var(--accent-blue);
    border-radius: 24px;
    padding: 2.2rem;
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    box-shadow: 0 15px 35px rgba(56, 189, 248, 0.15);
    margin-bottom: 3.5rem;
  }

  .banner-badge {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid var(--accent-blue);
    border-radius: 16px;
    padding: 1rem 1.4rem;
    text-align: center;
    min-width: 110px;
  }

  .banner-badge .time {
    display: block;
    font-size: 2rem;
    font-weight: 800;
    color: var(--accent-blue);
    font-family: 'Playfair Display', serif;
    line-height: 1;
  }

  .badge-tag {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-blue);
    margin-top: 0.3rem;
    letter-spacing: 1px;
  }

  .banner-body h3 {
    font-size: 1.5rem;
    color: var(--accent-blue);
    margin-bottom: 0.6rem;
  }

  .banner-body p {
    color: var(--text-muted);
    font-size: 1.05rem;
    line-height: 1.6;
  }

  @media (max-width: 700px) {
    .early-arrival-banner {
      flex-direction: column;
      gap: 1.2rem;
    }
  }

  /* LODGING GRID */
  .lodging-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.8rem;
  }

  .lodging-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 1.8rem;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .lodging-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8rem;
    gap: 0.5rem;
  }

  .lodging-type {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-gold);
    font-weight: 700;
  }

  .lodging-badge {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .lodging-name {
    font-size: 1.4rem;
    color: var(--text-light);
    margin-bottom: 0.4rem;
  }

  .lodging-dist {
    font-size: 0.9rem;
    color: var(--accent-blue);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .price-tag {
    color: var(--accent-green);
  }

  .lodging-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }

  .btn-sm {
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    width: 100%;
  }

  /* TRANSPORT */
  .alt-bg {
    background: rgba(30, 41, 59, 0.4);
    border-radius: 28px;
    padding: 3.5rem 2rem;
    margin: 3rem 0;
  }

  .transport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .transport-box {
    background: var(--bg-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.6rem;
    text-align: center;
  }

  .transport-icon {
    font-size: 2.5rem;
    margin-bottom: 0.8rem;
  }

  .transport-box h4 {
    font-size: 1.2rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .transport-box p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* FAQS */
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .faq-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.6rem;
  }

  .faq-q {
    font-size: 1.2rem;
    color: var(--accent-gold);
    margin-bottom: 0.6rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
  }

  .faq-a {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .dormire-cta {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-top: 3.5rem;
  }
</style>
