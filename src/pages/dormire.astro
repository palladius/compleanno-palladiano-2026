---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";

const aiDossiUrl = "https://www.aidossi.it/albergo.html";
const gmapsUrl = "https://www.google.com/maps/place/Ai+Dossi+Ristorante+Albergo/@44.5876103,11.9251564,17z/data=!4m6!3m5!1s0x477e114004cd3f2f:0xc1734f9bdd22ff6e!8m2!3d44.5876103!4d11.9251564!16s%2Fg%2F119wmhxcn";

const faqs = [
  {
    q_it: "Come vengono assegnati i 25 posti letto gratuiti?",
    q_en: "How are the 25 free guest beds allocated?",
    a_it: "I posti letto disponibili presso l'Albergo Ristorante Ai Dossi vengono offerti gratuitamente e prioritariamente a chi affronta un lungo viaggio (es. Svizzera, Torino, Perugia, Abruzzo, estero). Segnalacelo nel modulo RSVP!",
    a_en: "The available rooms at Albergo Ristorante Ai Dossi are offered free of charge with priority given to guests traveling long distances (e.g. Switzerland, Turin, Perugia, Abruzzo, abroad). Let us know in the RSVP form!"
  },
  {
    q_it: "A che ora posso arrivare per il check-in e la doccia?",
    q_en: "What time can I arrive to check in and freshen up?",
    a_it: "Dalle 15:00! Abbiamo previsto la fascia pomeridiana relax appositamente per chi viene da lontano: molli lo zaino in camera, ti fai una bella doccia calda rigenerante e scendi per l'aperitivo delle 18:00 in totale tranquillità.",
    a_en: "From 15:00! We scheduled an afternoon window specifically for long-distance travelers: drop your bags, take a refreshing hot shower, and stroll down for the 18:00 aperitivo without rushing."
  },
  {
    q_it: "Cosa devono fare gli ospiti che abitano vicino (intra-moenia)?",
    q_en: "What should local / nearby guests do (intra-moenia)?",
    a_it: "Per chi risiede nelle vicinanze o in zona limitrofa, chiediamo cortesemente di provvedere autonomamente per il rientro a casa o per eventuale pernottamento indipendente, in modo da riservare tutte le camere della struttura a chi arriva da centinaia di km di distanza.",
    a_en: "For local guests living in the nearby surrounding area, we kindly ask you to arrange your own return home or independent stay, leaving all on-site beds for those traveling hundreds of kilometers."
  },
  {
    q_it: "C'è parcheggio disponibile presso l'Albergo Ai Dossi?",
    q_en: "Is there parking available at Albergo Ai Dossi?",
    a_it: "Sì, ampio parcheggio riservato gratuito per tutte le auto, furgoni, bici da corsa e mezzi pesanti.",
    a_en: "Yes, ample free private parking for all cars, vans, bikes, and vehicles."
  }
];
---

<Layout title="Dormire & Logistica | 50° Compleanno Palladiano 🛏️" currentPage="dormire">
  <main class="container">
    <header class="section-header">
      <span class="tag-blue">🛏️ OSPITALITÀ & LOGISTICA DI VIAGGIO</span>
      <h1 class="page-title">
        <span lang-it>Dove Dormire & Alloggi</span>
        <span lang-en>Where to Stay & Accommodation</span>
      </h1>
      <p class="section-desc">
        <span lang-it>Tutte le informazioni per il pernottamento, l'assegnazione dei posti letto e la struttura ufficiale dell'evento.</span>
        <span lang-en>All the information on overnight stays, bed allocation, and the official event hotel.</span>
      </p>
    </header>

    <!-- PROMINENT POSTI LETTO NOTICE BOX -->
    <div class="priority-beds-notice">
      <div class="notice-icon">💛</div>
      <div class="notice-body">
        <h2 class="notice-title">
          <span lang-it>📢 Nota Bene: Posti Letto Gratuiti per chi viene da Lontano</span>
          <span lang-en>📢 Important Note: Free Guest Beds for Long-Distance Travelers</span>
        </h2>
        <p class="notice-main" lang-it>
          Abbiamo circa <strong>25 posti letto da distribuire gratuitamente</strong> a chi viene da più lontano (<em>Svizzera, Torino, Perugia, Abruzzo, ecc.</em>).
        </p>
        <p class="notice-main" lang-en>
          We have approximately <strong>25 guest beds to distribute free of charge</strong> to friends traveling from the furthest locations (<em>Switzerland, Turin, Perugia, Abruzzo, etc.</em>).
        </p>
        <p class="notice-sub" lang-it>
          👉 <strong>Per le persone che vengono da <em>intra-moenia</em> (zona locale/vicina):</strong> vi preghiamo cortesemente di attrezzarvi voi stessi per il rientro o alloggio indipendente, così da lasciare le camere a chi deve affrontare centinaia di chilometri di viaggio.
        </p>
        <p class="notice-sub" lang-en>
          👉 <strong>For local guests (intra-moenia):</strong> we kindly ask you to arrange your own transport home or independent stay, ensuring all on-site beds go to travelers crossing long distances.
        </p>
      </div>
    </div>

    <!-- EARLY ARRIVAL HIGHLIGHT BOX (15:00) -->
    <div class="early-arrival-banner">
      <div class="banner-badge">
        <span class="time">15:00</span>
        <span class="badge-tag" lang-it>[OPZIONALE]</span>
        <span class="badge-tag" lang-en>[OPTIONAL]</span>
      </div>
      <div class="banner-body">
        <h3 lang-it>Arrivi da lontano? Molla lo zaino e fai una doccia! Sento la puzza di ascelle fin da Zurigo! 🎒🚿</h3>
        <h3 lang-en>Traveling from afar? Drop your backpack & take a shower! I can smell armpits all the way from Zurich! 🎒🚿</h3>
        <p lang-it>
          Dalle <strong>15:00</strong> è possibile arrivare presso la struttura, fare il check-in, posare i bagagli, farsi una doccia calda rigenerante e rilassarsi prima dell'inizio ufficiale dell'aperitivo alle <strong>18:00</strong>.
        </p>
        <p lang-en>
          From <strong>15:00</strong> you can arrive at the venue, check in, drop your luggage, enjoy a relaxing hot shower, and get ready before the official <strong>18:00</strong> welcome drinks.
        </p>
      </div>
    </div>

    <!-- OFFICIAL HOTEL CARD: ALBERGO RISTORANTE AI DOSSI -->
    <section class="section">
      <div class="section-header">
        <span class="tag-gold">🏨 LA STRUTTURA UFFICIALE (UNICA SEDE)</span>
        <h2 lang-it>Albergo Ristorante Ai Dossi</h2>
        <h2 lang-en>Albergo Ristorante Ai Dossi</h2>
      </div>

      <div class="ai-dossi-card">
        <div class="ai-dossi-header">
          <div class="badge-dossi">📍 SEDE UFFICIALE FESTA & ALLOGGI</div>
          <h3>Albergo Ristorante Ai Dossi</h3>
          <p class="dossi-lead" lang-it>
            La location ospita sia il banchetto serale che le camere per il pernottamento degli ospiti da lontano.
          </p>
          <p class="dossi-lead" lang-en>
            The official venue hosting both the evening banquet and the overnight guest rooms.
          </p>
        </div>

        <div class="ai-dossi-features">
          <div class="dossi-feat">
            <span class="feat-icon">🛏️</span>
            <div>
              <strong lang-it>Camere in Loco</strong>
              <strong lang-en>On-Site Rooms</strong>
              <small lang-it>Zero spostamenti dopo la festa</small>
              <small lang-en>Zero driving after the party</small>
            </div>
          </div>
          <div class="dossi-feat">
            <span class="feat-icon">🚿</span>
            <div>
              <strong lang-it>Doccia & Relax dalle 15:00</strong>
              <strong lang-en>Shower & Relax from 15:00</strong>
              <small lang-it>Check-in pomeridiano per chi viaggia</small>
              <small lang-en>Afternoon check-in for travelers</small>
            </div>
          </div>
          <div class="dossi-feat">
            <span class="feat-icon">🚗</span>
            <div>
              <strong lang-it>Ampio Parcheggio</strong>
              <strong lang-en>Free Parking</strong>
              <small lang-it>Gratuito e riservato in loco</small>
              <small lang-en>Spacious and secure on-site</small>
            </div>
          </div>
        </div>

        <!-- ACTION BUTTONS: SITE + GOOGLE MAPS -->
        <div class="ai-dossi-cta-group">
          <a href={gmapsUrl} target="_blank" rel="noopener noreferrer" class="btn btn-maps">
            <span class="maps-icon">📍</span>
            <span lang-it>Apri su Google Maps 🗺️</span>
            <span lang-en>Open in Google Maps 🗺️</span>
          </a>
          <a href={aiDossiUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-dossi-site">
            <span lang-it>Sito Ufficiale: aidossi.it/albergo.html 🌐</span>
            <span lang-en>Official Website: aidossi.it/albergo.html 🌐</span>
          </a>
        </div>
      </div>
    </section>

    <!-- TRANSPORT & DIRECTIONS -->
    <section class="section alt-bg">
      <div class="section-header">
        <span class="tag-green">🚗 LOGISTICA & TRASPORTI</span>
        <h2 lang-it>Come Raggiungere la Struttura</h2>
        <h2 lang-en>Getting to the Venue</h2>
      </div>

      <div class="transport-grid">
        <div class="transport-box">
          <div class="transport-icon">🚗</div>
          <h4 lang-it>In Auto / Moto</h4>
          <h4 lang-en>By Car / Motorcycle</h4>
          <p lang-it>Autostrada A14 / A13. Ampio parcheggio gratuito e riservato direttamente all'ingresso dell'Albergo Ai Dossi.</p>
          <p lang-en>Highway A14 / A13. Generous free on-site parking directly at the entrance of Albergo Ai Dossi.</p>
        </div>
        <div class="transport-box">
          <div class="transport-icon">🚄</div>
          <h4 lang-it>In Treno</h4>
          <h4 lang-en>By Train (Frecciarossa/Italo)</h4>
          <p lang-it>Stazione AV di Bologna Centrale o Ferrara, con taxi o navette concordate per raggiungere la location.</p>
          <p lang-en>High-speed rail stations Bologna Centrale or Ferrara, followed by taxi or shared rides.</p>
        </div>
        <div class="transport-box">
          <div class="transport-icon">✈️</div>
          <h4 lang-it>In Aereo</h4>
          <h4 lang-en>By Plane</h4>
          <p lang-it>Aeroporto Guglielmo Marconi di Bologna (BLQ), a circa 45 minuti di tragitto.</p>
          <p lang-en>Bologna Airport (BLQ), roughly 45 minutes travel time.</p>
        </div>
      </div>
    </section>

    <!-- FAQS ACCORDION -->
    <section class="section">
      <div class="section-header">
        <span class="tag-gold">❓ DOMANDE FREQUENTI</span>
        <h2 lang-it>Domande Frequenti su Alloggio & Posti Letto</h2>
        <h2 lang-en>Frequently Asked Questions</h2>
      </div>

      <div class="faq-list">
        {faqs.map(faq => (
          <div class="faq-card">
            <h3 class="faq-q">
              <span lang-it>❓ {faq.q_it}</span>
              <span lang-en>❓ {faq.q_en}</span>
            </h3>
            <p class="faq-a">
              <span lang-it>{faq.a_it}</span>
              <span lang-en>{faq.a_en}</span>
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <div class="dormire-cta">
      <a href={publicFormUrl} target="_blank" class="btn btn-primary">
        <span lang-it>Richiedi Posto Letto nel Form RSVP ✍️</span>
        <span lang-en>Request Guest Bed via RSVP Form ✍️</span>
      </a>
      <a href={`${baseUrl}/contatti`} class="btn btn-secondary">
        <span lang-it>Hai altre domande? Scrivici ✉️</span>
        <span lang-en>More questions? Contact Us ✉️</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .page-title {
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: 0.8rem;
    color: var(--text-light);
  }

  /* PROMINENT BEDS NOTICE */
  .priority-beds-notice {
    background: linear-gradient(135deg, rgba(245, 158, 11, 0.15) 0%, rgba(30, 41, 59, 0.9) 100%);
    border: 2px solid var(--accent-gold);
    border-radius: 24px;
    padding: 2.2rem 2.4rem;
    display: flex;
    gap: 1.8rem;
    align-items: flex-start;
    box-shadow: 0 15px 35px rgba(245, 158, 11, 0.2);
    margin-bottom: 2.5rem;
  }

  .notice-icon {
    font-size: 3.2rem;
    line-height: 1;
    flex-shrink: 0;
  }

  .notice-title {
    font-size: 1.6rem;
    color: var(--accent-gold);
    margin-bottom: 0.8rem;
    font-family: 'Playfair Display', serif;
  }

  .notice-main {
    font-size: 1.15rem;
    color: var(--text-light);
    line-height: 1.6;
    margin-bottom: 0.8rem;
  }

  .notice-sub {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.55;
    background: rgba(0, 0, 0, 0.25);
    padding: 0.9rem 1.2rem;
    border-radius: 12px;
    border-left: 3px solid var(--accent-gold);
  }

  @media (max-width: 700px) {
    .priority-beds-notice {
      flex-direction: column;
      gap: 1rem;
      padding: 1.6rem;
    }
  }

  /* EARLY ARRIVAL BANNER */
  .early-arrival-banner {
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.9), rgba(30, 41, 59, 0.85));
    border: 2px solid var(--accent-blue);
    border-radius: 22px;
    padding: 1.8rem 2.2rem;
    display: flex;
    gap: 1.8rem;
    align-items: flex-start;
    box-shadow: 0 15px 35px rgba(56, 189, 248, 0.12);
    margin-bottom: 3.5rem;
  }

  .banner-badge {
    background: rgba(56, 189, 248, 0.15);
    border: 1px solid var(--accent-blue);
    border-radius: 16px;
    padding: 0.8rem 1.2rem;
    text-align: center;
    min-width: 105px;
  }

  .banner-badge .time {
    display: block;
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--accent-blue);
    font-family: 'Playfair Display', serif;
    line-height: 1;
  }

  .badge-tag {
    display: block;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-blue);
    margin-top: 0.3rem;
    letter-spacing: 1px;
  }

  .banner-body h3 {
    font-size: 1.35rem;
    color: var(--accent-blue);
    margin-bottom: 0.5rem;
  }

  .banner-body p {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  @media (max-width: 700px) {
    .early-arrival-banner {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* AI DOSSI CARD */
  .ai-dossi-card {
    background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
    border: 2px solid rgba(245, 158, 11, 0.45);
    border-radius: 26px;
    padding: 3rem 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
    max-width: 850px;
    margin: 0 auto;
    text-align: center;
  }

  .badge-dossi {
    display: inline-block;
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    margin-bottom: 1.2rem;
    letter-spacing: 1px;
  }

  .ai-dossi-card h3 {
    font-size: 2.3rem;
    color: var(--text-light);
    margin-bottom: 0.6rem;
  }

  .dossi-lead {
    color: var(--text-muted);
    font-size: 1.15rem;
    max-width: 650px;
    margin: 0 auto 2.2rem;
    line-height: 1.5;
  }

  .ai-dossi-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2.5rem;
    text-align: left;
  }

  .dossi-feat {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.2rem 1.4rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .feat-icon {
    font-size: 2.2rem;
  }

  .dossi-feat strong {
    display: block;
    font-size: 1rem;
    color: var(--accent-gold);
  }

  .dossi-feat small {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .ai-dossi-cta-group {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
  }

  .btn-maps {
    background: linear-gradient(135deg, #10b981, #059669);
    color: #ffffff;
    font-size: 1.15rem;
    font-weight: 800;
    padding: 1.1rem 2.2rem;
    border-radius: 14px;
    box-shadow: 0 8px 25px rgba(16, 185, 129, 0.4);
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .btn-maps:hover {
    background: #059669;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(16, 185, 129, 0.6);
  }

  .maps-icon {
    font-size: 1.4rem;
  }

  .btn-dossi-site {
    font-size: 1.05rem;
    padding: 1.1rem 1.8rem;
  }

  /* TRANSPORT */
  .alt-bg {
    background: rgba(30, 41, 59, 0.4);
    border-radius: 28px;
    padding: 3.5rem 2rem;
    margin: 3.5rem 0;
  }

  .transport-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .transport-box {
    background: var(--bg-surface);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 1.6rem;
    text-align: center;
  }

  .transport-icon {
    font-size: 2.5rem;
    margin-bottom: 0.8rem;
  }

  .transport-box h4 {
    font-size: 1.2rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .transport-box p {
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  /* FAQS */
  .faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .faq-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 1.6rem;
  }

  .faq-q {
    font-size: 1.15rem;
    color: var(--accent-gold);
    margin-bottom: 0.6rem;
    font-family: 'Outfit', sans-serif;
    font-weight: 700;
  }

  .faq-a {
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .dormire-cta {
    display: flex;
    justify-content: center;
    gap: 1.2rem;
    flex-wrap: wrap;
    margin-top: 3rem;
  }
</style>
