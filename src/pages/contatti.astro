---
import Layout from '../layouts/Layout.astro';
const telegramUrl = "https://t.me/+kx-bUGjBoFs0ODlk";
const whatsappAnnunciUrl = "https://chat.whatsapp.com/BCQDijWNCa45A6srlXpZjo";
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";
---

<Layout title="Contatti | 50° Compleanno Palladiano ✉️" currentPage="contatti">
  <main class="container">
    <div class="contact-wrapper">
      <header class="section-header">
        <span class="tag-gold">✉️ CONTATTI & MESSAGGI</span>
        <h1 class="page-title">
          <span lang-it>Scrivi a Riccardo</span>
          <span lang-en>Contact Riccardo</span>
        </h1>
        <p class="section-desc">
          <span lang-it>Hai una domanda sull'evento, un'esigenza particolare o vuoi mandare un messaggio di auguri?</span>
          <span lang-en>Got a question about the event, dietary needs, or want to send birthday wishes?</span>
        </p>
      </header>

      <div class="contact-card">
        <!-- WHATSAPP - CONSIGLIATO -->
        <div class="channel-block channel-primary">
          <div class="channel-badge">⭐ <span lang-it>CONSIGLIATO</span><span lang-en>RECOMMENDED</span></div>
          <a href={whatsappAnnunciUrl} target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-block">
            <span class="ch-icon">📢</span>
            <span lang-it>Canale WhatsApp</span>
            <span lang-en>WhatsApp Channel</span>
          </a>
          <p class="channel-desc">
            <span lang-it>Annunci ufficiali, orari, aggiornamenti dell'ultimo minuto. Il modo più veloce per restare aggiornati!</span>
            <span lang-en>Official announcements, schedules, last-minute updates. The fastest way to stay in the loop!</span>
          </p>
        </div>

        <!-- TELEGRAM - BACKUP -->
        <div class="channel-block">
          <a href={telegramUrl} target="_blank" rel="noopener noreferrer" class="btn btn-telegram btn-block">
            <span class="ch-icon">✈️</span>
            <span lang-it>Community Telegram</span>
            <span lang-en>Telegram Community</span>
          </a>
          <p class="channel-desc">
            <span lang-it>Alternativa per chi preferisce Telegram. Stesse info, stessa allegria!</span>
            <span lang-en>Alternative for Telegram fans. Same info, same fun!</span>
          </p>
        </div>

        <!-- SEPARATORE -->
        <hr class="channel-divider" />

        <!-- RSVP FORM - CON AVVISO FOMO -->
        <div class="channel-block channel-rsvp">
          <div class="rsvp-warning">
            <span class="warning-icon">⚠️</span>
            <p>
              <span lang-it><strong>ATTENZIONE:</strong> Se non compili la form RSVP, il tuo posto a tavola <strong>NON è garantito!</strong> Possiamo organizzare cena e posti letto solo per chi si registra.</span>
              <span lang-en><strong>WARNING:</strong> If you don't fill out the RSVP form, your seat at the table is <strong>NOT guaranteed!</strong> We can only arrange dinner and beds for registered guests.</span>
            </p>
          </div>
          <a href={publicFormUrl} target="_blank" rel="noopener noreferrer" class="btn btn-rsvp btn-block">
            <span class="ch-icon">✍️</span>
            <span lang-it>Compila la Form RSVP</span>
            <span lang-en>Fill Out the RSVP Form</span>
          </a>
          <p class="channel-desc">
            <span lang-it>Conferma la tua presenza, indica quanti siete, eventuali intolleranze e se servono posti letto.</span>
            <span lang-en>Confirm your attendance, how many you are, any dietary needs and if you need a bed.</span>
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .contact-wrapper {
    max-width: 640px;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .page-title {
    font-size: 2.6rem;
    margin-bottom: 0.6rem;
    color: var(--text-light);
  }

  .contact-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.98));
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 22px;
    padding: 2.4rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .channel-block {
    text-align: center;
  }

  .channel-badge {
    display: inline-block;
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    padding: 0.3rem 1rem;
    border-radius: 20px;
    margin-bottom: 0.8rem;
  }

  .channel-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 0.6rem;
    line-height: 1.5;
  }

  .channel-divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 0.4rem 0;
  }

  .btn-block {
    width: 100%;
    padding: 1rem;
    font-size: 1.05rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-block:hover {
    transform: translateY(-2px);
  }

  .ch-icon {
    font-size: 1.2rem;
  }

  .btn-whatsapp {
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(37, 211, 102, 0.35);
  }

  .btn-whatsapp:hover {
    background: #20ba59;
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
  }

  .btn-telegram {
    background: linear-gradient(135deg, #0088cc, #006699);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(0, 136, 204, 0.35);
  }

  .btn-telegram:hover {
    background: #0077b5;
    box-shadow: 0 6px 20px rgba(0, 136, 204, 0.5);
  }

  .btn-rsvp {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.35);
    font-size: 1.1rem;
  }

  .btn-rsvp:hover {
    background: #e8910a;
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.5);
  }

  .rsvp-warning {
    background: rgba(245, 158, 11, 0.12);
    border: 1px solid rgba(245, 158, 11, 0.5);
    border-radius: 14px;
    padding: 1.2rem 1.4rem;
    margin-bottom: 1rem;
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    text-align: left;
  }

  .rsvp-warning .warning-icon {
    font-size: 1.6rem;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .rsvp-warning p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-light);
  }

  @media (max-width: 600px) {
    .contact-card {
      padding: 1.4rem;
    }

    .rsvp-warning {
      padding: 1rem;
    }
  }
</style>

