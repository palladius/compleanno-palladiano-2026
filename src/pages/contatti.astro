---
import Layout from '../layouts/Layout.astro';
const contactEmail = "palladiusbonton+50anni@gmail.com";
---

<Layout title="Contatti | 50° Compleanno Palladiano ✉️" currentPage="contatti">
  <main class="container">
    <div class="contact-wrapper">
      <header class="section-header">
        <span class="tag-gold">✉️ CONTATTI</span>
        <h1 class="page-title">
          <span lang-it>Scrivi a Riccardo</span>
          <span lang-en>Contact Riccardo</span>
        </h1>
        <p class="section-desc">
          <span lang-it>Hai una domanda sull'evento, un'esigenza particolare o vuoi mandare un messaggio?</span>
          <span lang-en>Got a question about the event, special requests, or want to send a message?</span>
        </p>
      </header>

      <!-- CLEAN CENTERED FORM CARD -->
      <div class="contact-card">
        <form id="contactForm" class="contact-form">
          <div class="form-group">
            <label for="senderName">
              <span lang-it>Il tuo Nome:</span>
              <span lang-en>Your Name:</span>
            </label>
            <input type="text" id="senderName" name="name" placeholder="Nome e Cognome" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="msgSubject">
              <span lang-it>Oggetto:</span>
              <span lang-en>Subject:</span>
            </label>
            <input type="text" id="msgSubject" name="subject" placeholder="Es. Domanda sulla serata / Canzone Rock '80" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="msgBody">
              <span lang-it>Messaggio:</span>
              <span lang-en>Message:</span>
            </label>
            <textarea id="msgBody" name="body" rows="5" placeholder="Scrivi qui..." required class="form-input form-textarea"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block">
            <span lang-it>Invia Messaggio ✉️</span>
            <span lang-en>Send Message ✉️</span>
          </button>
        </form>

        <div class="direct-link-wrap">
          <a href={`mailto:${contactEmail}?subject=50%C2%B0%20Compleanno%20Palladiano`} class="direct-email-link">
            <span lang-it>Oppure apri direttamente una nuova email 📧</span>
            <span lang-en>Or open a new email directly 📧</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ contactEmail }}>
    const form = document.getElementById('contactForm');
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('senderName').value.trim();
        const subject = document.getElementById('msgSubject').value.trim();
        const bodyText = document.getElementById('msgBody').value.trim();

        const fullSubject = encodeURIComponent(`[50° Compleanno] ${subject} (da ${name})`);
        const fullBody = encodeURIComponent(`Ciao Riccardo,

${bodyText}

---
Da: ${name}`);

        window.location.href = `mailto:${contactEmail}?subject=${fullSubject}&body=${fullBody}`;
      });
    }
  </script>
</Layout>

<style>
  .contact-wrapper {
    max-width: 620px;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .page-title {
    font-size: 2.6rem;
    margin-bottom: 0.6rem;
    color: var(--text-light);
  }

  .contact-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.95), rgba(15, 23, 42, 0.98));
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 22px;
    padding: 2.2rem;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }

  .form-group label {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text-light);
  }

  .form-input {
    background: rgba(11, 17, 32, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-light);
    padding: 0.85rem 1rem;
    border-radius: 12px;
    font-size: 1rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent-gold);
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.3);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .btn-block {
    width: 100%;
    margin-top: 0.5rem;
    padding: 1rem;
    font-size: 1.05rem;
  }

  .direct-link-wrap {
    text-align: center;
    margin-top: 1.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .direct-email-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    transition: color 0.2s ease;
  }

  .direct-email-link:hover {
    color: var(--accent-gold);
    text-decoration: underline;
  }
</style>
