---
import Layout from '../layouts/Layout.astro';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const contactEmail = "palladiusbonton+50anni@gmail.com";
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";
---

<Layout title="Contatti | 50° Compleanno Palladiano ✉️" currentPage="contatti">
  <main class="container">
    <header class="section-header">
      <span class="tag-gold">✉️ COMUNICAZIONI & DOMANDE</span>
      <h1 class="page-title">
        <span lang-it>Scrivi a Riccardo</span>
        <span lang-en>Contact Riccardo</span>
      </h1>
      <p class="section-desc">
        <span lang-it>Hai una domanda sull'evento, vuoi proporre una canzone rock anni '80 o mandare un messaggio di auguri? Compila il modulo sotto o mandami una mail diretta!</span>
        <span lang-en>Got a question about the event, want to suggest an 80s rock anthem, or send early birthday wishes? Use the form below or drop a direct email!</span>
      </p>
    </header>

    <div class="contact-layout">
      <!-- DIRECT CONTACT INFO CARD -->
      <div class="contact-info-card">
        <div class="info-icon">📬</div>
        <h3 lang-it>Email Diretta</h3>
        <h3 lang-en>Direct Email</h3>
        <p lang-it>Scrivi all'indirizzo speciale dedicato al Cinquantesimo:</p>
        <p lang-en>Drop a line to the special 50th birthday inbox:</p>
        
        <div class="email-badge">
          <code>{contactEmail}</code>
        </div>

        <div class="info-buttons">
          <a href={`mailto:${contactEmail}?subject=50%20Compleanno%20Palladiano%20-%20Messaggio`} class="btn btn-primary btn-block">
            <span lang-it>Apri nel tuo Client Email 📧</span>
            <span lang-en>Open in Email App 📧</span>
          </a>
          <button id="copyEmailBtn" class="btn btn-secondary btn-block">
            <span lang-it>Copia Indirizzo 📋</span>
            <span lang-en>Copy Address 📋</span>
          </button>
        </div>

        <hr class="card-divider" />

        <div class="info-secondary">
          <h4 lang-it>Modulo RSVP Ufficiale</h4>
          <h4 lang-en>Official RSVP Form</h4>
          <p lang-it>Per confermare la tua presenza al banchetto, usa preferibilmente il form Google:</p>
          <p lang-en>To officially confirm your presence at the feast, please use the Google Form:</p>
          <a href={publicFormUrl} target="_blank" class="btn btn-secondary btn-block" style="margin-top: 0.8rem;">
            <span lang-it>Compila Google Form (RSVP) ✍️</span>
            <span lang-en>Fill RSVP Form ✍️</span>
          </a>
        </div>
      </div>

      <!-- PURE HTML MAILTO FORM -->
      <div class="contact-form-card">
        <h3 lang-it>Invia un Messaggio Diretto 🚀</h3>
        <h3 lang-en>Send a Direct Message 🚀</h3>
        <p class="form-instruction">
          <span lang-it>Compila i campi: il pulsante preparerà automaticamente l'email formattata pronta per l'invio!</span>
          <span lang-en>Fill in the fields: the button will automatically prepare your formatted email ready to send!</span>
        </p>

        <form id="contactForm" class="contact-form" action={`mailto:${contactEmail}`} method="GET" enctype="text/plain">
          <div class="form-group">
            <label for="senderName">
              <span lang-it>Il tuo Nome & Cognome:</span>
              <span lang-en>Your Full Name:</span>
            </label>
            <input type="text" id="senderName" name="name" placeholder="Es. Mario Rossi / Luke Skywalker" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="senderEmail">
              <span lang-it>La tua Email (per la risposta):</span>
              <span lang-en>Your Email (for replies):</span>
            </label>
            <input type="email" id="senderEmail" name="email" placeholder="mario@example.com" required class="form-input" />
          </div>

          <div class="form-group">
            <label for="msgSubject">
              <span lang-it>Oggetto del Messaggio:</span>
              <span lang-en>Subject:</span>
            </label>
            <select id="msgSubject" name="subject" class="form-input form-select">
              <option value="50° Compleanno - Domanda Logistica / Alloggio">Domanda Logistica / Alloggio</option>
              <option value="50° Compleanno - Richiesta / Esigenza Alimentare">Esigenza Alimentare / Dieta</option>
              <option value="50° Compleanno - Proposta Canzone Rock Anni 80">Proposta Canzone Rock Anni '80 🎸</option>
              <option value="50° Compleanno - Messaggio di Auguri / Saluti">Messaggio di Auguri / Saluto 💛</option>
              <option value="50° Compleanno - Altro">Altro</option>
            </select>
          </div>

          <div class="form-group">
            <label for="msgBody">
              <span lang-it>Il tuo Messaggio:</span>
              <span lang-en>Your Message:</span>
            </label>
            <textarea id="msgBody" name="body" rows="5" placeholder="Scrivi qui il tuo messaggio per Riccardo..." required class="form-input form-textarea"></textarea>
          </div>

          <button type="submit" class="btn btn-primary btn-block" style="font-size: 1.05rem; padding: 1rem;">
            <span lang-it>Invia Messaggio via Email ✉️💨</span>
            <span lang-en>Send Message via Email ✉️💨</span>
          </button>
        </form>

        <div id="formSuccessToast" class="form-toast" style="display: none;">
          <span lang-it>✅ Client di posta aperto con il tuo messaggio pronto per l'invio!</span>
          <span lang-en>✅ Email client opened with your message ready to send!</span>
        </div>
      </div>
    </div>
  </main>

  <script define:vars={{ contactEmail }}>
    // Copy email button
    const copyBtn = document.getElementById('copyEmailBtn');
    if (copyBtn) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(contactEmail).then(() => {
          const originalText = copyBtn.innerHTML;
          copyBtn.innerHTML = '<span>✅ Copiato! / Copied!</span>';
          setTimeout(() => {
            copyBtn.innerHTML = originalText;
          }, 2000);
        });
      });
    }

    // Form client-side handler for mailto construction
    const form = document.getElementById('contactForm');
    const toast = document.getElementById('formSuccessToast');

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const name = document.getElementById('senderName').value;
        const email = document.getElementById('senderEmail').value;
        const subject = document.getElementById('msgSubject').value;
        const bodyText = document.getElementById('msgBody').value;

        const fullSubject = encodeURIComponent(`${subject} [da ${name}]`);
        const fullBody = encodeURIComponent(`Ciao Riccardo,

${bodyText}

---
Mittente: ${name}
Email: ${email}
(Inviato da palladius.github.io/compleanno-palladiano-2026)`);

        const mailtoUri = `mailto:${contactEmail}?subject=${fullSubject}&body=${fullBody}`;
        
        window.location.href = mailtoUri;

        if (toast) {
          toast.style.display = 'block';
          setTimeout(() => {
            toast.style.display = 'none';
          }, 6000);
        }
      });
    }
  </script>
</Layout>

<style>
  .page-title {
    font-size: 3rem;
    line-height: 1.2;
    margin-bottom: 0.8rem;
    color: var(--text-light);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 2.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 860px) {
    .contact-layout {
      grid-template-columns: 1fr;
    }
  }

  /* CONTACT INFO CARD */
  .contact-info-card {
    background: var(--bg-card);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
  }

  .info-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .contact-info-card h3 {
    font-size: 1.6rem;
    color: var(--accent-gold);
    margin-bottom: 0.5rem;
  }

  .contact-info-card p {
    color: var(--text-muted);
    font-size: 0.98rem;
    line-height: 1.5;
    margin-bottom: 1.2rem;
  }

  .email-badge {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid var(--accent-gold);
    border-radius: 12px;
    padding: 0.9rem 1rem;
    margin-bottom: 1.5rem;
    text-align: center;
    word-break: break-all;
  }

  .email-badge code {
    color: var(--accent-gold);
    font-size: 1rem;
    font-weight: 700;
  }

  .info-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .btn-block {
    width: 100%;
    text-align: center;
  }

  .card-divider {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 2rem 0 1.5rem;
  }

  .info-secondary h4 {
    font-size: 1.2rem;
    color: var(--text-light);
    margin-bottom: 0.4rem;
  }

  /* CONTACT FORM CARD */
  .contact-form-card {
    background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(15, 23, 42, 0.95));
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: 24px;
    padding: 2.5rem 2.2rem;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.45);
  }

  .contact-form-card h3 {
    font-size: 1.8rem;
    color: var(--accent-gold);
    margin-bottom: 0.4rem;
  }

  .form-instruction {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 1.8rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.3rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    text-align: left;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-light);
  }

  .form-input {
    background: rgba(11, 17, 32, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--text-light);
    padding: 0.85rem 1rem;
    border-radius: 12px;
    font-size: 0.98rem;
    font-family: inherit;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent-gold);
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.3);
  }

  .form-select {
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-toast {
    margin-top: 1.2rem;
    padding: 1rem;
    background: rgba(16, 185, 129, 0.18);
    border: 1px solid var(--accent-green);
    border-radius: 12px;
    color: var(--accent-green);
    font-weight: 600;
    font-size: 0.95rem;
    text-align: center;
  }
</style>
