---
interface Props {
  title: string;
  currentPage?: string;
}

const { title, currentPage = 'home' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const publicFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe7pxMlIpxkDulRh-8460JMo3VTDrOgrDahOHObCmnFk-o_Eg/viewform";
---

<!doctype html>
<html lang="it" data-lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="50° Compleanno Palladiano - 29 Dicembre 2026 | 50 Shades of Yellow" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,800;1,400;1,700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <!-- IMMUTABLE FROSTED GLASS HEADER -->
    <header class="site-header" id="siteHeader">
      <div class="nav-container">
        <a href={`${baseUrl}/`} class="nav-brand">
          <span class="brand-badge">👑 50°</span>
          <span class="brand-title">
            <span class="font-serif gold-text">Palladiano</span>
            <span class="brand-year">'26</span>
          </span>
        </a>

                <!-- DESKTOP NAV -->
        <nav class="nav-links">
          <a href={`${baseUrl}/`} class={`nav-link ${currentPage === 'home' || currentPage === 'programma' ? 'active' : ''}`}>
            <span class="nav-icon">⏰</span>
            <span lang-it>Programma</span>
            <span lang-en>Schedule</span>
          </a>
          <a href={`${baseUrl}/menu`} class={`nav-link ${currentPage === 'menu' ? 'active' : ''}`}>
            <span class="nav-icon">🍽️</span>
            <span>Menu</span>
          </a>
          <a href={`${baseUrl}/dormire`} class={`nav-link ${currentPage === 'dormire' ? 'active' : ''}`}>
            <span class="nav-icon">🛏️</span>
            <span lang-it>Dormire</span>
            <span lang-en>Accommodation</span>
          </a>
          <a href={`${baseUrl}/contatti`} class={`nav-link ${currentPage === 'contatti' ? 'active' : ''}`}>
            <span class="nav-icon">✉️</span>
            <span lang-it>Contatti</span>
            <span lang-en>Contact</span>
          </a>
          <a href={publicFormUrl} target="_blank" class="nav-btn-rsvp">
            <span lang-it>RSVP ✍️</span>
            <span lang-en>RSVP ✍️</span>
          </a>
        </nav>

        <!-- SHARE BTN + LANGUAGE SWITCHER + MOBILE MENU BTN -->
        <div class="nav-actions">
          <button type="button" class="btn-share-header" id="btnShareModal" title="Condividi / Share">
            <span class="share-icon">🔗</span>
            <span class="share-text" lang-it>Condividi</span>
            <span class="share-text" lang-en>Share</span>
          </button>

          <div class="lang-switch-wrapper" role="group" aria-label="Language Switcher">
            <button type="button" class="lang-btn active" id="btnLangIt" data-lang="it" title="Italiano">
              <span class="flag-icon">🇮🇹</span>
              <span class="lang-text">IT</span>
            </button>
            <span class="lang-divider">/</span>
            <button type="button" class="lang-btn" id="btnLangEn" data-lang="en" title="English">
              <span class="flag-icon">🇬🇧</span>
              <span class="lang-text">EN</span>
            </button>
          </div>

          <button class="mobile-toggle" id="mobileMenuBtn" aria-label="Menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <!-- MOBILE DRAWER -->
      <div class="mobile-drawer" id="mobileDrawer">
        <a href={`${baseUrl}/`} class={`mobile-link ${currentPage === 'home' || currentPage === 'programma' ? 'active' : ''}`}>
          <span>⏰</span>
          <span lang-it>Programma della Serata</span>
          <span lang-en>Evening Schedule</span>
        </a>
        <a href={`${baseUrl}/menu`} class={`mobile-link ${currentPage === 'menu' ? 'active' : ''}`}>
          <span>🍽️</span>
          <span lang-it>Menu d'Avanguardia</span>
          <span lang-en>Avant-Garde Menu</span>
        </a>
        <a href={`${baseUrl}/dormire`} class={`mobile-link ${currentPage === 'dormire' ? 'active' : ''}`}>
          <span>🛏️</span>
          <span lang-it>Dormire & Logistica</span>
          <span lang-en>Accommodation & Logistics</span>
        </a>
        <a href={`${baseUrl}/contatti`} class={`mobile-link ${currentPage === 'contatti' ? 'active' : ''}`}>
          <span>✉️</span>
          <span lang-it>Scrivi a Riccardo & Ermete</span>
          <span lang-en>Contact Riccardo & Ermete</span>
        </a>
        <a href={publicFormUrl} target="_blank" class="mobile-btn-rsvp">
          <span lang-it>Conferma Presenza (RSVP) ✍️</span>
          <span lang-en>Confirm Attendance (RSVP) ✍️</span>
        </a>
      </div>
    </header>

    <div class="page-wrapper">
      <slot />
    </div>

    <!-- GLOBAL FOOTER -->
    <footer class="footer">
      <div class="footer-content">
        <p class="footer-title">
          <strong>50 Sfumature di Giallo</strong> • 29 Dicembre 2026
        </p>
                <div class="footer-nav">
          <a href={`${baseUrl}/`}><span lang-it>Programma</span><span lang-en>Schedule</span></a> •
          <a href={`${baseUrl}/menu`}>Menu</a> •
          <a href={`${baseUrl}/dormire`}><span lang-it>Dormire</span><span lang-en>Accommodation</span></a> •
          <a href={`${baseUrl}/contatti`}><span lang-it>Contatti</span><span lang-en>Contact</span></a> •
          <a href={`${baseUrl}/stats`}><span lang-it>Statistiche</span><span lang-en>Stats</span></a> •
          <a href={`${baseUrl}/faq`}>FAQ</a> •
          <a href={publicFormUrl} target="_blank">RSVP Form</a>
        </div>
        <small class="footer-credit">
          Confezionato con ❤️, Astro & 🚛 da Ermete Bottazzi • 
          <a href="https://github.com/palladius/compleanno-palladiano-2026" target="_blank">GitHub Repo</a>
        </small>
      </div>
    </footer>

    <!-- LANGUAGE & MOBILE MENU CONTROLLER SCRIPT -->
    <script is:inline>
      (function() {
        const savedLang = localStorage.getItem('palladius_lang') || 'it';
        setLanguage(savedLang);

        const btnIt = document.getElementById('btnLangIt');
        const btnEn = document.getElementById('btnLangEn');

        if (btnIt && btnEn) {
          btnIt.addEventListener('click', () => setLanguage('it'));
          btnEn.addEventListener('click', () => setLanguage('en'));
        }

        function setLanguage(lang) {
          document.documentElement.setAttribute('data-lang', lang);
          document.documentElement.lang = lang;
          localStorage.setItem('palladius_lang', lang);

          const itBtn = document.getElementById('btnLangIt');
          const enBtn = document.getElementById('btnLangEn');

          if (itBtn && enBtn) {
            if (lang === 'it') {
              itBtn.classList.add('active');
              enBtn.classList.remove('active');
            } else {
              enBtn.classList.add('active');
              itBtn.classList.remove('active');
            }
          }
        }

        
        // Share Modal Controller
        const shareBtn = document.getElementById('btnShareModal');
        const shareModal = document.getElementById('shareModal');
        const shareBackdrop = document.getElementById('shareModalBackdrop');
        const shareClose = document.getElementById('shareModalClose');
        const copyBtn = document.getElementById('copyShareLinkBtn');
        const shareInput = document.getElementById('shareUrlInput');
        const qrImg = document.getElementById('qrCodeImg');

        function openShareModal() {
          if (!shareModal) return;
          const currentUrl = window.location.href;
          if (shareInput) shareInput.value = currentUrl;
          if (qrImg) {
            qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=10&color=0f172a&bgcolor=ffffff&data=${encodeURIComponent(currentUrl)}`;
          }

          shareModal.classList.add('active');
          shareModal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        }

        function closeShareModal() {
          if (!shareModal) return;
          shareModal.classList.remove('active');
          shareModal.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (shareBtn) shareBtn.addEventListener('click', openShareModal);
        if (shareClose) shareClose.addEventListener('click', closeShareModal);
        if (shareBackdrop) shareBackdrop.addEventListener('click', closeShareModal);

        if (copyBtn && shareInput) {
          copyBtn.addEventListener('click', () => {
            navigator.clipboard.writeText(shareInput.value).then(() => {
              const itText = document.getElementById('copyBtnText');
              const enText = document.getElementById('copyBtnTextEn');
              if (itText) itText.innerText = '✅ Link Copiato!';
              if (enText) enText.innerText = '✅ Link Copied!';
              setTimeout(() => {
                if (itText) itText.innerText = 'Copia Link 📋';
                if (enText) enText.innerText = 'Copy Link 📋';
              }, 2500);
            });
          });
        }

        // Mobile drawer toggle
        const toggleBtn = document.getElementById('mobileMenuBtn');
        const drawer = document.getElementById('mobileDrawer');

        if (toggleBtn && drawer) {
          toggleBtn.addEventListener('click', () => {
            const isOpen = drawer.classList.toggle('open');
            toggleBtn.setAttribute('aria-expanded', String(isOpen));
          });
        }
      })();
    </script>

    <!-- SHARE QR CODE MODAL -->
    <div id="shareModal" class="share-modal" aria-hidden="true">
      <div class="share-modal-backdrop" id="shareModalBackdrop"></div>
      <div class="share-modal-container">
        <button class="share-modal-close" id="shareModalClose" aria-label="Chiudi">&times;</button>
        
        <div class="share-modal-header">
          <span class="badge-share">📲 CONDIVIDI L'EVENTO</span>
          <h2 class="share-modal-title">
            <span lang-it>50° Compleanno Palladiano</span>
            <span lang-en>50th Palladian Birthday</span>
          </h2>
          <p class="share-modal-sub">
            <span lang-it>Mostra il QR Code a un amico o copia il link negli appunti per inviarlo su WhatsApp o Telegram!</span>
            <span lang-en>Show this QR code or copy the link to share via WhatsApp or Telegram!</span>
          </p>
        </div>

        <div class="qr-container">
          <div class="qr-frame">
            <img 
              id="qrCodeImg"
              src="https://api.qrserver.com/v1/create-qr-code/?size=260x260&margin=10&color=0f172a&bgcolor=ffffff&data=https://palladius.github.io/compleanno-palladiano-2026/" 
              alt="QR Code Compleanno Palladiano" 
              class="qr-image"
            />
          </div>
        </div>

        <div class="share-link-box">
          <input 
            type="text" 
            id="shareUrlInput" 
            value="https://palladius.github.io/compleanno-palladiano-2026/" 
            readonly 
            class="share-input" 
          />
          <button type="button" id="copyShareLinkBtn" class="btn btn-primary btn-copy">
            <span id="copyBtnText" lang-it>Copia Link 📋</span>
            <span id="copyBtnTextEn" lang-en>Copy Link 📋</span>
          </button>
        </div>

        <div class="share-quick-channels">
          <a id="waShareBtn" href="https://api.whatsapp.com/send?text=50%C2%B0%20Compleanno%20Palladiano%20%7C%2050%20Sfumature%20di%20Giallo%20%F0%9F%92%9B%20https%3A%2F%2Fpalladius.github.io%2Fcompleanno-palladiano-2026%2F" target="_blank" class="channel-btn wa-btn">
            <span>💬 WhatsApp</span>
          </a>
          <a id="tgShareBtn" href="https://t.me/share/url?url=https%3A%2F%2Fpalladius.github.io%2Fcompleanno-palladiano-2026%2F&text=50%C2%B0%20Compleanno%20Palladiano%20%7C%2050%20Sfumature%20di%20Giallo%20%F0%9F%92%9B" target="_blank" class="channel-btn tg-btn">
            <span>✈️ Telegram</span>
          </a>
        </div>
      </div>
    </div>

  </body>
</html>

<style is:global>
  :root {
    --bg-dark: #0b1120;
    --bg-surface: #0f172a;
    --bg-card: #1e293b;
    --bg-card-hover: #273549;
    --accent-gold: #f59e0b;
    --accent-gold-glow: rgba(245, 158, 11, 0.4);
    --accent-green: #10b981;
    --accent-blue: #38bdf8;
    --text-light: #f8fafc;
    --text-muted: #94a3b8;
    --header-height: 72px;
  }

  /* LANGUAGE VISIBILITY TOGGLE */
  html[data-lang="it"] [lang-en] {
    display: none !important;
  }
  html[data-lang="en"] [lang-it] {
    display: none !important;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: 'Outfit', sans-serif;
    background-color: var(--bg-dark);
    color: var(--text-light);
    line-height: 1.6;
    overflow-x: hidden;
    padding-top: var(--header-height);
  }

  h1, h2, h3, .font-serif {
    font-family: 'Playfair Display', serif;
  }

  .gold-text {
    color: var(--accent-gold);
    background: linear-gradient(135deg, #fbbf24, #d97706);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  /* STICKY GLASS HEADER */
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height);
    z-index: 1000;
    background: rgba(15, 23, 42, 0.82);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    border-bottom: 1px solid rgba(245, 158, 11, 0.25);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.45);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-container {
    max-width: 1160px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--text-light);
    transition: transform 0.2s ease;
  }

  .nav-brand:hover {
    transform: scale(1.03);
  }

  .brand-badge {
    background: rgba(245, 158, 11, 0.18);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.5px;
  }

  .brand-year {
    color: var(--accent-gold);
    font-weight: 800;
    font-size: 1rem;
    margin-left: 2px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.8rem;
    color: var(--text-muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 10px;
    border: 1px solid transparent;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: var(--text-light);
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-link.active {
    color: var(--accent-gold);
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.35);
    box-shadow: 0 0 15px rgba(245, 158, 11, 0.15);
  }

  .nav-btn-rsvp {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #0f172a;
    font-weight: 800;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 0.45rem 1rem;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(245, 158, 11, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    margin-left: 0.4rem;
  }

  .nav-btn-rsvp:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(245, 158, 11, 0.55);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  /* LANGUAGE SWITCHER BADGE */
  .lang-switch-wrapper {
    display: flex;
    align-items: center;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 0.2rem 0.4rem;
    gap: 0.2rem;
  }

  .lang-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.25rem 0.5rem;
    border-radius: 9999px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: all 0.2s ease;
  }

  .lang-btn:hover {
    color: var(--text-light);
  }

  .lang-btn.active {
    background: var(--accent-gold);
    color: #0f172a;
    box-shadow: 0 2px 8px rgba(245, 158, 11, 0.4);
  }

  .lang-divider {
    color: rgba(255, 255, 255, 0.2);
    font-size: 0.8rem;
  }

  .flag-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  /* MOBILE TOGGLE & DRAWER */
  .mobile-toggle {
    display: none;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.5rem;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
  }

  .mobile-toggle span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text-light);
    transition: all 0.2s ease;
  }

  .mobile-drawer {
    display: none;
    position: absolute;
    top: var(--header-height);
    left: 0;
    right: 0;
    background: rgba(15, 23, 42, 0.96);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(245, 158, 11, 0.3);
    padding: 1.2rem 1.5rem;
    flex-direction: column;
    gap: 0.8rem;
    box-shadow: 0 15px 30px rgba(0, 0, 0, 0.6);
  }

  .mobile-drawer.open {
    display: flex;
  }

  .mobile-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1rem;
    border-radius: 10px;
    color: var(--text-light);
    text-decoration: none;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.04);
  }

  .mobile-link.active {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: var(--accent-gold);
  }

  .mobile-btn-rsvp {
    margin-top: 0.5rem;
    text-align: center;
    background: var(--accent-gold);
    color: #0f172a;
    font-weight: 800;
    padding: 0.8rem;
    border-radius: 10px;
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .nav-links {
      display: none;
    }
    .mobile-toggle {
      display: flex;
    }
  }

  /* BUTTONS & GENERAL UTILS */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.8rem;
    border-radius: 12px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
    font-size: 1rem;
    border: none;
  }

  .btn-primary {
    background: var(--accent-gold);
    color: #0f172a;
    box-shadow: 0 4px 15px rgba(245, 158, 11, 0.35);
  }

  .btn-primary:hover {
    background: #d97706;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(245, 158, 11, 0.5);
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  /* SECTIONS */
  .section {
    padding: 4.5rem 0 3rem;
  }

  .section-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .tag-green {
    color: var(--accent-green);
    font-weight: 700;
    letter-spacing: 1.5px;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tag-gold {
    color: var(--accent-gold);
    font-weight: 700;
    letter-spacing: 1.5px;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .tag-blue {
    color: var(--accent-blue);
    font-weight: 700;
    letter-spacing: 1.5px;
    font-size: 0.85rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .section-header h2 {
    font-size: 2.3rem;
    margin-bottom: 0.8rem;
  }

  .section-desc {
    color: var(--text-muted);
    font-size: 1.05rem;
  }


  /* SHARE BUTTON IN HEADER */
  .btn-share-header {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.35);
    color: var(--accent-gold);
    border-radius: 9999px;
    padding: 0.38rem 0.8rem;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: all 0.2s ease;
  }

  .btn-share-header:hover {
    background: var(--accent-gold);
    color: #0f172a;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);
  }

  .share-icon {
    font-size: 0.95rem;
    line-height: 1;
  }

  /* SHARE MODAL */
  .share-modal {
    position: fixed;
    top: 0;
    left: 0;
